@page
@model Tour_Management.Pages.UserLoginModel
@{
    ViewData["Title"] = "User Login";
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
    <style type="text/css">
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            text-align: center;
            background-color: black;
            width: 100%;
            font-size: 30px;
            color: white;
            padding-bottom: 150px;
            opacity: 0.8;
        }
    </style>
    <script src="./script.js"></script>
    <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Rubik:400,700'>
</head>
<body>
    <br />
    <br />

    <div class="login-form">
        <div class="container">
            <div class="page-header">
                <h1>User Login</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert" style="color:red; font-size:16px;">@Model.StatusMessage</div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="control-label col-sm-4">
                            <label for="Email">Email</label>
                        </div>
                        <div class="col-sm-6">
                            <input id="Email" name="Email" type="email" required="required"
                                   class="form-control" style="color:black;"
                                   value="@Model.Email" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="control-label col-sm-4">
                            <label for="Password">Password</label>
                        </div>
                        <div class="col-sm-6">
                            <input id="Password" name="Password" type="password" required="required"
                                   class="form-control" style="color:black;" />
                        </div>
                        <div class="control-label col-sm-2">
                            <button type="submit" name="handler" value="Login"
                                    style="background-color:#cc6600; color:black; height:35px; width:92px;"
                                    class="form-control">Login</button>
                        </div>
                        <div class="control-label col-sm-2">
                            <button type="submit" name="handler" value="SignUp"
                                    style="background-color:#cc6600; color:black; height:38px; width:137px;"
                                    class="form-control">Sign Up</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <p>&nbsp;</p>
</body>
</html>
