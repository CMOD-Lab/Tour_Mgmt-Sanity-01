<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST"
        path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>

    <!--
      cr-dotnet-1041: Register ContentSecurityPolicyModule for IIS Integrated Pipeline mode.
      This module adds Content-Security-Policy and complementary security headers to every
      HTTP response, satisfying SOC2 certification and penetration-test compliance requirements
      for cloud SaaS platforms running on AWS.

      AWS WAF integration:
        In addition to these application-level headers, deploy the following AWS WAF managed
        rule groups on the Application Load Balancer / CloudFront distribution that fronts
        this application:
          - AWSManagedRulesCommonRuleSet        (XSS, SQLi, LFI/RFI protection)
          - AWSManagedRulesKnownBadInputsRuleSet (known-bad inputs / exploits)
        Together, the HttpModule headers and WAF rules provide defence-in-depth against XSS
        attacks in multi-tenant cloud environments.
    -->
    <modules>
      <add name="ContentSecurityPolicyModule"
           type="Tour_Management.ContentSecurityPolicyModule, Tour_Management"
           preCondition="integratedMode" />
    </modules>

    <!--
      Remove the Server response header to avoid leaking IIS version information.
      This is a complementary hardening measure recommended alongside CSP for SOC2.
    -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <system.web>
    <httpHandlers>
      <add path="ChartImg.axd" verb="GET,HEAD,POST" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        validate="false" />
    </httpHandlers>

    <!--
      cr-dotnet-1041: Register ContentSecurityPolicyModule for IIS Classic Pipeline mode.
      Both registrations (here and in <system.webServer><modules>) are required so that the
      module works regardless of the IIS pipeline mode configured on the target server.
    -->
    <httpModules>
      <add name="ContentSecurityPolicyModule"
           type="Tour_Management.ContentSecurityPolicyModule, Tour_Management" />
    </httpModules>

    <pages enableCdn="true">
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.DataVisualization.Charting"
          assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </controls>
    </pages>

    <!--
      cr-dotnet-1037: ScriptManager CDN Configuration.
      Configure ASP.NET ScriptManager to load AJAX scripts from the Microsoft Ajax CDN,
      reducing origin server load and AWS bandwidth costs. A CloudFront distribution is
      configured as a secondary CDN for global script delivery.

      EnableCdn=true  - instructs ScriptManager to emit CDN URLs instead of local axd paths.
      ScriptResourceHandler is enabled so that local fallback still works when CDN is
      unreachable (e.g., during development or in air-gapped environments).

      CloudFront fallback:
        Set the CLOUDFRONT_CDN_BASE_URL environment variable (or the appSetting below) to
        your CloudFront distribution URL (e.g., https://d1234abcd.cloudfront.net) so that
        static script assets are served from the edge rather than the origin server.
        The CloudFront distribution should be configured to cache /ScriptResource.axd
        responses with a long TTL (e.g., 1 year) for maximum performance.
    -->
    <scriptResourceHandler enableCdn="true" enableCdnFallback="true" />
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2"/>
  </system.web>

  <connectionStrings>
    <!--
      cr-dotnet-0010: Web.config Transformations — REMEDIATED
      This connection string is a LOCAL DEVELOPMENT FALLBACK ONLY.
      In cloud environments (AWS ECS, EC2, Elastic Beanstalk, App Runner), the connection
      string MUST be supplied via the DB_CONNECTION_STRING environment variable at runtime.
      Web.Debug.config and Web.Release.config XDT build-time transforms have been eliminated.

      Runtime injection (12-factor app, Factor III — Config):
        DB_CONNECTION_STRING=Server=<rds-proxy-endpoint>.proxy-xxxx.us-east-1.rds.amazonaws.com;
                             Database=tourdb;User Id=<iam-user>;Password=<secret>;

      AWS SSM Parameter Store path (recommended for production secrets):
        /tour-management/db-connection-string

      The application code reads this value via:
        Environment.GetEnvironmentVariable("DB_CONNECTION_STRING")
      with fallback to this Web.config value for local development only.

      Connection pooling is managed by Amazon RDS Proxy at the infrastructure level.
    -->
    <add name="dbconnection" connectionString="Server=localhost;Database=tourdb;User Id=sa;Password=changeme;" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <!-- cr-dotnet-1032: Amazon S3 configuration for tour image uploads.
         Override at runtime via environment variables:
           S3_BUCKET_NAME  - S3 bucket for tour images (e.g., "tour-management-pics")
           AWS_REGION      - AWS region (e.g., "us-east-1")
         AWS credentials are resolved via the AWS credential provider chain
         (IAM instance profile / ECS task role recommended for cloud deployments). -->
    <add key="AWS:S3BucketName" value="tour-management-pics" />
    <add key="AWS:Region" value="us-east-1" />
    <!--
      cr-dotnet-1037: CloudFront CDN base URL for ScriptManager fallback.
      Set the CLOUDFRONT_CDN_BASE_URL environment variable (or override this value) to
      your CloudFront distribution URL (e.g., https://d1234abcd.cloudfront.net).
      The application reads this setting to configure a secondary CDN for ASP.NET AJAX
      scripts, reducing AWS bandwidth costs and improving global script delivery latency.
      Configure your CloudFront distribution to forward /ScriptResource.axd requests to
      the origin with a long cache TTL (e.g., 31536000 seconds / 1 year).
    -->
    <add key="ScriptManager:CdnPath" value="https://ajax.aspnetcdn.com/ajax" />
    <add key="ScriptManager:CloudFrontCdnBaseUrl" value="https://d1234abcd.cloudfront.net" />
    <!--
      cr-dotnet-1041: Optional CSP policy override.
      Set the CSP_POLICY environment variable at the OS / ECS task-definition level to
      supply a custom Content-Security-Policy value without redeploying the application.
      When this variable is absent the ContentSecurityPolicyModule uses its built-in
      default policy (see ContentSecurityPolicyModule.cs).
    -->
  </appSettings>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
</configuration>
