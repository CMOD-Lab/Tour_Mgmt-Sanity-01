<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST"
        path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>
    <!-- cr-dotnet-1041: Content Security Policy headers for cloud SOC2 / pen-test compliance -->
    <httpProtocol>
      <customHeaders>
        <!-- Content-Security-Policy: restrict sources to self + trusted CDNs; adjust as needed -->
        <!-- cr-dotnet-1037: ajax.aspnetcdn.com added to script-src to allow Microsoft Ajax CDN scripts -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://ajax.aspnetcdn.com https://ajax.microsoft.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self';" />
        <!-- Additional security headers recommended for cloud / SOC2 compliance -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>
    <!-- cr-dotnet-1041: Register the CspHttpModule for programmatic CSP header management -->
    <modules>
      <add name="CspHttpModule" type="Tour_Management.CspHttpModule" />
    </modules>
  </system.webServer>
  <system.web>
    <httpHandlers>
      <add path="ChartImg.axd" verb="GET,HEAD,POST" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        validate="false" />
    </httpHandlers>
    <!-- cr-dotnet-1041: Register the CspHttpModule for Classic pipeline mode -->
    <httpModules>
      <add name="CspHttpModule" type="Tour_Management.CspHttpModule" />
    </httpModules>
    <pages>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.DataVisualization.Charting"
          assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </controls>
    </pages>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2"/>
  </system.web>
  <!-- cr-dotnet-1037: Configure ScriptManager to load ASP.NET AJAX scripts from Microsoft Ajax CDN
       with a CloudFront distribution as a secondary CDN, reducing origin server load and AWS bandwidth costs.
       EnableCdn=true instructs ScriptManager to emit CDN URLs instead of serving scripts from the origin.
       The CdnPath overrides point to the Microsoft Ajax CDN (ajax.aspnetcdn.com).
       The CloudFront appSettings keys below allow runtime substitution of the CDN base URL
       with an AWS CloudFront distribution URL for additional edge caching. -->
  <system.web.extensions>
    <scripting>
      <scriptResourceHandler enableCdn="true" enableCdnFallback="true" />
      <webServices>
        <jsonSerialization maxJsonLength="500000" />
      </webServices>
    </scripting>
  </system.web.extensions>
  <connectionStrings>
    <!--
      cr-dotnet-0010: The hardcoded LocalDB connection string below is provided as a LOCAL DEVELOPMENT
      FALLBACK ONLY. In AWS cloud deployments, this value is NEVER used.
      Runtime configuration is injected via environment variables or AWS SSM Parameter Store:
        - Set RDS_CONNECTION_STRING environment variable to the Amazon RDS / RDS Proxy endpoint connection string
        - OR set SSM_DBCONNECTION environment variable (injected from /tour-management/dbconnection SSM key)
      Web.Debug.config and Web.Release.config build-time transformations have been deprecated (cr-dotnet-0010).
    -->
    <add name="dbconnection" connectionString="#{RDS_CONNECTION_STRING}#" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <!-- cr-dotnet-1041: CSP nonce seed – override via environment variable / AWS Parameter Store -->
    <add key="CSP:ReportUri" value="" />
    <add key="CSP:Enabled" value="true" />
    <!-- cr-dotnet-1037: ScriptManager CDN configuration
         ScriptManager:EnableCdn        – set to "true" to serve AJAX scripts from Microsoft Ajax CDN
                                          (https://ajax.aspnetcdn.com). Override to "false" in environments
                                          without internet access.
         ScriptManager:CdnBaseUrl       – Base URL for the primary CDN. Defaults to Microsoft Ajax CDN.
                                          Override with your AWS CloudFront distribution domain
                                          (e.g. https://d1234abcd.cloudfront.net) to route script
                                          requests through CloudFront for lower AWS data-transfer costs
                                          and global edge caching.
         ScriptManager:EnableCdnFallback – set to "true" so the browser falls back to the origin server
                                           if the CDN is unreachable. -->
    <add key="ScriptManager:EnableCdn" value="true" />
    <add key="ScriptManager:CdnBaseUrl" value="https://ajax.aspnetcdn.com/ajax/" />
    <add key="ScriptManager:EnableCdnFallback" value="true" />
    <!-- CloudFront secondary CDN – set this to your CloudFront distribution URL to override the
         primary CDN base URL at runtime (read by Global.asax / startup code if present). -->
    <add key="ScriptManager:CloudFrontCdnUrl" value="" />
  </appSettings>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
</configuration>
