<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST"
        path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>
    <!-- cr-dotnet-1041: Register ContentSecurityPolicyModule for IIS integrated-pipeline mode.
         This module injects Content-Security-Policy, X-Content-Type-Options, and
         Referrer-Policy headers on every response to satisfy SOC2 and penetration-test
         requirements in AWS cloud environments.
         AWS WAF complement: associate the "AWSManagedRulesCommonRuleSet" and
         "AWSManagedRulesKnownBadInputsRuleSet" managed rule groups with the WAF WebACL
         attached to the ALB / CloudFront distribution in front of this application. -->
    <modules>
      <add name="ContentSecurityPolicyModule"
           type="Tour_Management.ContentSecurityPolicyModule, Tour_Management"
           preCondition="integratedMode" />
    </modules>
    <!-- cr-dotnet-1041: Declarative CSP header via IIS customHeaders as a secondary
         enforcement layer (applies even before the HttpModule fires for static files). -->
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' https://ajax.aspnetcdn.com https://ajax.microsoft.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <system.web>
    <httpHandlers>
      <add path="ChartImg.axd" verb="GET,HEAD,POST" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        validate="false" />
    </httpHandlers>
    <!-- cr-dotnet-1041: Register ContentSecurityPolicyModule for IIS classic-pipeline mode. -->
    <httpModules>
      <add name="ContentSecurityPolicyModule"
           type="Tour_Management.ContentSecurityPolicyModule, Tour_Management" />
    </httpModules>
    <pages>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.DataVisualization.Charting"
          assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </controls>
    </pages>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2"/>
    <!-- cr-dotnet-1037: Enable ScriptResource compression and caching so that when scripts
         are served from the application origin (fallback path) they are still optimised. -->
    <scriptResourceHandler enableCompression="true" enableCaching="true" />
  </system.web>
  <connectionStrings>
    <add name="dbconnection" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\gajer\source\repos\Tour_Management\Tour_Management\App_Data\tourdb.mdf;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <!-- In AWS cloud environments, set the DB_CONNECTION_STRING environment variable to point
       to the Amazon RDS Proxy endpoint, e.g.:
       "Server=<rds-proxy-endpoint>,1433;Database=tourdb;User Id=<user>;Password=<password>;
        TrustServerCertificate=True;Max Pool Size=100;Min Pool Size=5;"
       The application code reads DB_CONNECTION_STRING first, falling back to the above for local dev. -->
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <!-- cr-dotnet-1037: ScriptManager CDN configuration.
         EnableCdn=true instructs every ScriptManager on the site to load ASP.NET AJAX
         scripts from the Microsoft Ajax CDN (ajax.aspnetcdn.com) instead of the
         application origin, reducing AWS bandwidth costs and improving global latency.

         CloudFront fallback:
           Create a CloudFront distribution whose origin is ajax.aspnetcdn.com and set
           ScriptManager_CdnFallbackUrl to your CloudFront domain so that if the primary
           Microsoft Ajax CDN is unreachable the scripts are served from the CloudFront
           edge cache rather than the origin server.

         DEPLOYMENT STEPS:
           1. Replace "https://YOUR_CLOUDFRONT_DOMAIN" below with the actual CloudFront
              distribution domain (e.g. https://d1234abcd.cloudfront.net) that caches
              /ajax/4.5/ paths from ajax.aspnetcdn.com as the origin.
           2. Ensure the CloudFront distribution has HTTPS enabled and the correct
              cache behaviours for /ajax/* paths.
           3. The ScriptManager_EnableCdn key is read by the base Page class or a
              custom HttpModule to set ScriptManager.EnableCdn = true at runtime.
              Alternatively, set EnableCdn="true" directly on each <asp:ScriptManager>
              control in your .aspx pages. -->
    <add key="ScriptManager_EnableCdn" value="true" />
    <add key="ScriptManager_CdnPath" value="https://ajax.aspnetcdn.com/ajax/4.5/" />
    <add key="ScriptManager_CdnFallbackUrl" value="https://YOUR_CLOUDFRONT_DOMAIN/ajax/4.5/" />
    <add key="ScriptManager_CdnFallbackExpression" value="window.MicrosoftAjax" />
  </appSettings>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
</configuration>
