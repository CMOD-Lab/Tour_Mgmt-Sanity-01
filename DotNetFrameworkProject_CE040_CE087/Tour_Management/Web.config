<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST"
        path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>

    <!--
      cr-dotnet-1041: Register the custom CspHttpModule so that Content-Security-Policy
      and complementary security headers are injected into every HTTP response.
      This module runs in IIS Integrated Pipeline mode and satisfies SOC2 / penetration-
      test compliance requirements for cloud-hosted ASP.NET Web Forms applications.

      AWS deployment note:
        Pair this application-layer CSP enforcement with AWS WAF managed rule groups
        (e.g. AWSManagedRulesCommonRuleSet, AWSManagedRulesKnownBadInputsRuleSet)
        attached to the ALB or CloudFront distribution in front of this application
        to achieve defence-in-depth XSS protection in multi-tenant cloud environments.
    -->
    <modules>
      <add name="CspHttpModule"
           type="Tour_Management.CspHttpModule, Tour_Management"
           preCondition="integratedMode" />
    </modules>

    <!--
      cr-dotnet-1041: Static security headers applied at the IIS level as a
      complementary layer to the CspHttpModule above.  These headers are served
      for all requests, including static files, that bypass the managed pipeline.
    -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove the Server header to avoid leaking version information -->
        <remove name="X-Powered-By" />
        <!-- Strict-Transport-Security: enforces HTTPS for 1 year (required for SOC2) -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <system.web>
    <httpHandlers>
      <add path="ChartImg.axd" verb="GET,HEAD,POST" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        validate="false" />
    </httpHandlers>

    <!--
      cr-dotnet-1041: Register the CspHttpModule for Classic Pipeline mode
      (fallback registration; Integrated Pipeline registration above is preferred).
    -->
    <httpModules>
      <add name="CspHttpModule" type="Tour_Management.CspHttpModule, Tour_Management" />
    </httpModules>

    <pages>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.DataVisualization.Charting"
          assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </controls>
    </pages>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2"/>
  </system.web>
  <!--
    Cloud (AWS) deployment: Set the DB_CONNECTION_STRING environment variable to the
    Amazon RDS Proxy endpoint connection string. The application code reads this variable
    at runtime and uses it in preference to the value below.
    Example RDS Proxy connection string:
      Server=<rds-proxy-endpoint>;Database=tourdb;User Id=<db-user>;Password=<db-password>;
    The connection string below is retained as a local-development fallback only.
  -->
  <connectionStrings>
    <add name="dbconnection" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\tourdb.mdf;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />

    <!--
      cr-dotnet-1037: ScriptManager CDN Configuration
      Configure ASP.NET ScriptManager to load AJAX scripts from the Microsoft Ajax CDN
      with AWS CloudFront as a secondary CDN fallback, reducing origin server load and
      AWS bandwidth costs while improving global script delivery performance.

      Microsoft Ajax CDN base URL used by ScriptManager when EnableCdn="true" is set
      on the ScriptManager control in ASPX pages.
    -->

    <!-- Enable CDN delivery for ASP.NET AJAX scripts via Microsoft Ajax CDN -->
    <add key="aspnet:ScriptResourceAllowOrigin" value="https://ajax.aspnetcdn.com" />

    <!--
      Primary CDN: Microsoft Ajax CDN
      ScriptManager will load MicrosoftAjax.js and related scripts from this CDN
      when EnableCdn="true" is set on the ScriptManager control.
      Usage in ASPX: <asp:ScriptManager EnableCdn="true" EnableCdnFallback="true" runat="server" />
    -->
    <add key="ScriptManager.MicrosoftCdnPath" value="https://ajax.aspnetcdn.com/ajax/4.5.2/" />

    <!--
      Secondary CDN: AWS CloudFront distribution
      Set CLOUDFRONT_CDN_DOMAIN as an environment variable in AWS (Elastic Beanstalk /
      ECS task definition / App Runner) to the CloudFront distribution domain that
      fronts your static assets (e.g. d1234abcd.cloudfront.net).
      The application reads this value at runtime to construct CDN URLs for custom
      script bundles served through the CloudFront distribution.
      If the environment variable is not set, the Microsoft Ajax CDN path above is used.
    -->
    <add key="ScriptManager.CloudFrontCdnPath" value="" />

  </appSettings>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
</configuration>
