<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<!--
  ============================================================
  cr-dotnet-0010 : Web.config Transformations — REMEDIATED
  ============================================================
  Web.config transformation files (Web.Debug.config, Web.Release.config)
  have been superseded by runtime environment variable injection and
  AWS Systems Manager Parameter Store.

  CONNECTION STRING RESOLUTION ORDER (runtime):
    1. Environment variable  : DB_CONNECTION_STRING
       Set in ECS task definition, Elastic Beanstalk environment
       properties, or App Runner service configuration.
    2. AWS SSM Parameter Store: /tour-management/db-connection-string
       Resolved at startup by AwsSsmHelper when env var is absent.
    3. Web.config connectionStrings (local development fallback only)
       The placeholder value below is used ONLY when neither of the
       above sources provides a value (i.e., local developer workstation).
       Do NOT store production credentials here.

  ENVIRONMENT VARIABLES REFERENCE:
    DB_CONNECTION_STRING          — ADO.NET connection string
    S3_TOUR_PICS_BUCKET           — S3 bucket for tour image uploads
    CSP_POLICY                    — Content-Security-Policy header override
    CLOUDFRONT_CDN_HOST           — CloudFront distribution domain
    ASPNET_ENV                    — Runtime environment (Production/Development)
  ============================================================
-->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST"
        path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>
    <!-- ============================================================
         cr-dotnet-1041 : Content Security Policy Headers
         Register the custom HttpModule for IIS Integrated Pipeline.
         AWS WAF managed rules (AWSManagedRulesCommonRuleSet) provide
         the network-layer enforcement complement to this header.
         ============================================================ -->
    <!-- ============================================================
         cr-dotnet-1037 : ScriptManager CDN Configuration
         Enable Microsoft Ajax CDN for ASP.NET AJAX scripts to reduce
         origin server load and AWS bandwidth costs. A CloudFront
         distribution acts as a secondary CDN / fallback path.
         ============================================================ -->
    <modules>
      <add name="ContentSecurityPolicyModule"
           type="Tour_Management.Security.ContentSecurityPolicyModule, Tour_Management"
           preCondition="integratedMode" />
    </modules>
    <!-- Declarative CSP header via IIS customHeaders (belt-and-suspenders).
         The HttpModule above also sets this header programmatically so that
         it is present even on responses that bypass the static-file handler. -->
    <httpProtocol>
      <customHeaders>
        <!-- Content-Security-Policy: enforces allowed content sources (SOC2 / pen-test) -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" />
        <!-- Complementary security headers -->
        <add name="X-Content-Type-Options"  value="nosniff" />
        <add name="X-Frame-Options"         value="DENY" />
        <add name="X-XSS-Protection"        value="1; mode=block" />
        <add name="Referrer-Policy"         value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"      value="geolocation=(), microphone=(), camera=(), payment=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <system.web>
    <httpHandlers>
      <add path="ChartImg.axd" verb="GET,HEAD,POST" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        validate="false" />
    </httpHandlers>
    <!-- ============================================================
         cr-dotnet-1037 : ScriptManager CDN – scriptResourceHandler
         Enables the built-in ASP.NET script-resource handler to serve
         scripts from the Microsoft Ajax CDN when EnableCdn="true" is
         set on the ScriptManager control (or via appSettings below).
         ============================================================ -->
    <scriptResourceHandler enableCdn="true" enableCdnFallback="true" />
    <!-- ============================================================
         cr-dotnet-1041 : Register the CSP HttpModule for Classic
         Pipeline mode (IIS 6 / IIS Express classic mode fallback).
         ============================================================ -->
    <httpModules>
      <add name="ContentSecurityPolicyModule"
           type="Tour_Management.Security.ContentSecurityPolicyModule, Tour_Management" />
    </httpModules>
    <pages>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.DataVisualization.Charting"
          assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </controls>
    </pages>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2"/>
  </system.web>
  <!--
    ============================================================
    cr-dotnet-0010 : Connection String — Environment Variable Driven
    ============================================================
    PRODUCTION / CLOUD: The application resolves the connection string
    at runtime from the DB_CONNECTION_STRING environment variable first,
    then falls back to AWS Systems Manager Parameter Store key
    /tour-management/db-connection-string.

    The value below is a LOCAL DEVELOPMENT PLACEHOLDER ONLY.
    It must NOT be used in any cloud-deployed environment.
    Set the DB_CONNECTION_STRING environment variable in your AWS
    deployment configuration (ECS, Elastic Beanstalk, App Runner)
    to override this value at runtime.

    AWS SSM Parameter Store path: /tour-management/db-connection-string
    AWS Secrets Manager secret  : tour-management/db-credentials
    ============================================================
  -->
  <connectionStrings>
    <add name="dbconnection"
         connectionString="#{DB_CONNECTION_STRING}#"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <!-- ============================================================
         cr-dotnet-0010 : S3 Bucket — Environment Variable Driven
         Override at runtime via S3_TOUR_PICS_BUCKET environment variable
         or AWS SSM Parameter Store key /tour-management/s3-tour-pics-bucket.
         The value below is the default bucket name for local/dev use.
         ============================================================ -->
    <add key="S3TourPicsBucket" value="tour-management-tour-pics" />
    <!-- cr-dotnet-1041: Optional override for the CSP policy string.
         Set this key (or the CSP_POLICY environment variable) to customise the policy
         per environment without a code change.  Leave empty to use the compiled default. -->
    <add key="CspPolicy" value="" />
    <!-- ============================================================
         cr-dotnet-1037 : ScriptManager CDN Configuration
         EnableCdn  – instructs every ScriptManager on the site to
                      load ASP.NET AJAX scripts from the Microsoft
                      Ajax CDN instead of the application origin,
                      reducing AWS bandwidth costs and latency.
         EnableCdnFallback – if the CDN is unreachable the browser
                      falls back to the local script resource handler
                      automatically (inline JS probe injected by ASP.NET).
         CloudFrontCdnPath – optional secondary CDN prefix backed by
                      an AWS CloudFront distribution that sits in front
                      of the Microsoft Ajax CDN origin.  Set the
                      CLOUDFRONT_CDN_HOST environment variable to your
                      CloudFront domain (e.g. d1234abcd.cloudfront.net)
                      to activate; leave blank to use the Microsoft CDN
                      directly.
         ============================================================ -->
    <add key="aspnet:ScriptManagerEnableCdn"         value="true" />
    <add key="aspnet:ScriptManagerEnableCdnFallback" value="true" />
    <add key="CloudFrontCdnHost"
         value="" />
  </appSettings>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
</configuration>
