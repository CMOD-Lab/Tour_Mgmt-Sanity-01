<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImageHandler" />
      <add name="ChartImageHandler" preCondition="integratedMode" verb="GET,HEAD,POST"
        path="ChartImg.axd" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </handlers>
    <!-- ============================================================
         cr-dotnet-1041 : Missing Content Security Policy Headers
         Register the CspHttpModule for IIS Integrated Pipeline mode.
         AWS WAF managed rules (AWSManagedRulesCommonRuleSet) should
         be enabled on the ALB / CloudFront distribution in front of
         this application to satisfy SOC2 / pen-test requirements.
         ============================================================ -->
    <modules>
      <add name="CspHttpModule"
           type="Tour_Management.Security.CspHttpModule, Tour_Management"
           preCondition="integratedMode" />
    </modules>
    <!-- Remove the Server header to reduce information disclosure -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
  <system.web>
    <httpHandlers>
      <add path="ChartImg.axd" verb="GET,HEAD,POST" type="System.Web.UI.DataVisualization.Charting.ChartHttpHandler, System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        validate="false" />
    </httpHandlers>
    <!-- ============================================================
         cr-dotnet-1041 : Register CspHttpModule for Classic Pipeline
         mode (fallback; Integrated Pipeline is preferred on IIS 7+).
         ============================================================ -->
    <httpModules>
      <add name="CspHttpModule"
           type="Tour_Management.Security.CspHttpModule, Tour_Management" />
    </httpModules>
    <!-- ============================================================
         cr-dotnet-1037 : ScriptManager Without CDN Configuration
         Configure ASP.NET ScriptManager to load Microsoft AJAX scripts
         from the Microsoft Ajax CDN (primary) with a CloudFront
         distribution as a secondary CDN fallback.

         EnableCdn=true          – instructs ScriptManager to emit CDN
                                   URLs instead of serving scripts from
                                   the origin server.
         EnableCdnFallback=true  – if the primary CDN is unreachable the
                                   browser falls back to the origin-served
                                   copy, ensuring resilience.

         The Microsoft Ajax CDN base path is set via the
         ScriptManager:MicrosoftAjaxCdnPath appSetting.
         The CloudFront distribution URL is set via the
         ScriptManager:CloudFrontCdnPath appSetting so it can be
         overridden at runtime via:
           • AWS Elastic Beanstalk environment variable
           • AWS Systems Manager Parameter Store
             (/tour-mgmt/ScriptManager/CloudFrontCdnPath)
           • AWS Secrets Manager
         ============================================================ -->
    <pages enableEventValidation="true">
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.DataVisualization.Charting"
          assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </controls>
    </pages>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2"/>
  </system.web>
  <connectionStrings>
    <!-- RDS Proxy endpoint is supplied via the DB_CONNECTION_STRING environment variable at runtime.
         The value below is a fallback for local development only. -->
    <add name="dbconnection" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\tourdb.mdf;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <!-- AWS S3 configuration for cloud file storage (cr-dotnet-1032).
         Override these values at runtime via environment variables:
           S3_BUCKET_NAME  – target S3 bucket for tour image uploads
           AWS_REGION      – AWS region where the bucket resides
         IAM role credentials are resolved automatically on AWS compute (EC2/ECS/Lambda).
    -->
    <add key="AWS:S3BucketName" value="tour-management-uploads" />
    <add key="AWS:Region" value="us-east-1" />
    <!-- ============================================================
         cr-dotnet-1041 : Content Security Policy (CSP) configuration
         Override this value at runtime via:
           • AWS Systems Manager Parameter Store  (/tour-mgmt/CSP/Policy)
           • AWS Secrets Manager
           • Elastic Beanstalk environment variable  CSP__Policy
         Leave empty to use the built-in default policy defined in
         Tour_Management.Security.CspHttpModule.
         ============================================================ -->
    <add key="CSP:Policy" value="" />
    <!-- ============================================================
         cr-dotnet-1037 : ScriptManager CDN Configuration
         Primary CDN  : Microsoft Ajax CDN
           https://ajax.aspnetcdn.com/ajax/4.5.2/1/MicrosoftAjax.js
         Secondary CDN: AWS CloudFront distribution acting as a caching
           proxy / secondary CDN for AJAX scripts.

         ScriptManager:EnableCdn
           Set to "true" to enable CDN script delivery globally.
           Override via Elastic Beanstalk env var or SSM Parameter Store.

         ScriptManager:EnableCdnFallback
           Set to "true" to fall back to origin if CDN is unreachable.

         ScriptManager:MicrosoftAjaxCdnPath
           Base URL of the Microsoft Ajax CDN.
           Default: https://ajax.aspnetcdn.com/ajax

         ScriptManager:CloudFrontCdnPath
           CloudFront distribution URL used as a secondary CDN.
           Replace <DISTRIBUTION_ID> with your actual CloudFront domain,
           e.g. https://d1234abcd.cloudfront.net/ajax
           Override at runtime via:
             • AWS Elastic Beanstalk environment variable
             • AWS Systems Manager Parameter Store
               (/tour-mgmt/ScriptManager/CloudFrontCdnPath)
         ============================================================ -->
    <add key="ScriptManager:EnableCdn" value="true" />
    <add key="ScriptManager:EnableCdnFallback" value="true" />
    <add key="ScriptManager:MicrosoftAjaxCdnPath" value="https://ajax.aspnetcdn.com/ajax" />
    <add key="ScriptManager:CloudFrontCdnPath" value="https://your-cloudfront-distribution.cloudfront.net/ajax" />
  </appSettings>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
</configuration>
