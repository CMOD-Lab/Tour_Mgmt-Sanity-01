<?xml version="1.0" encoding="utf-8"?>

<!--
  ============================================================
  cr-dotnet-0010: Web.config Transformations — REMEDIATED
  ============================================================
  This Web.Release.config transformation file has been superseded by
  environment variables and AWS Systems Manager (SSM) Parameter Store
  as part of the cloud readiness remediation for rule cr-dotnet-0010.

  Build-time Web.config XDT transformations are NOT compatible with
  cloud deployment pipelines where configuration must be:
    1. Externalized from build artifacts (12-factor app, Factor III)
    2. Runtime-injectable without rebuilding the application image
    3. Managed centrally via AWS SSM Parameter Store or Secrets Manager

  REPLACEMENT STRATEGY — Environment Variables (Release / Production):
  ─────────────────────────────────────────────────────────────────────
  All settings previously managed via Web.Release.config XDT transforms
  (including the <compilation xdt:Transform="RemoveAttributes(debug)" />
  directive) are now supplied as environment variables at runtime.

  Required environment variables for Release / Production environment:
    DB_CONNECTION_STRING
      Description : SQL Server / Amazon RDS Proxy connection string
      Example     : Server=<rds-proxy-endpoint>.proxy-xxxx.us-east-1.rds.amazonaws.com;
                    Database=tourdb;User Id=<iam-user>;Password=<secret>;
      SSM Path    : /tour-management/prod/db-connection-string
      Secrets Mgr : arn:aws:secretsmanager:us-east-1:<account>:secret:tour-management/db

    ASPNETCORE_ENVIRONMENT (or ASPNET_ENV for .NET Framework on IIS)
      Description : Runtime environment name
      Value       : Production

    AWS_REGION
      Description : AWS region for SDK clients (S3, SSM, Secrets Manager)
      Example     : us-east-1

    S3_BUCKET_NAME
      Description : Amazon S3 bucket for tour image uploads
      Example     : tour-management-pics-prod

    COMPILATION_DEBUG
      Description : Replaces the XDT RemoveAttributes(debug) transform.
                    Set to "false" in production to disable debug compilation.
      Value       : false

  AWS SSM Parameter Store paths (recommended for secrets):
    /tour-management/prod/db-connection-string   → DB connection string
    /tour-management/prod/s3-bucket-name         → S3 bucket name

  HOW TO INJECT AT RUNTIME:
  ─────────────────────────
  • EC2 / ECS          : Set in ECS task definition environment section
                         or EC2 Systems Manager Parameter Store integration
  • AWS Elastic Beanstalk : Set in Environment Properties (Configuration → Software)
  • AWS App Runner     : Set in Service configuration → Environment variables
  • AWS Secrets Manager: Use the AWS SDK to retrieve secrets at application startup
                         (recommended for DB_CONNECTION_STRING in production)

  NOTE: This file is retained in the repository as documentation only.
        The XDT transformation namespace and transform attributes have been
        removed. No build-time transformations are applied from this file.
        The previous <compilation xdt:Transform="RemoveAttributes(debug)" />
        directive is replaced by the COMPILATION_DEBUG=false environment variable.
  ============================================================
-->

<configuration>
  <!--
    Release-specific settings previously applied via XDT transforms are now
    supplied via environment variables listed above.

    Example: to disable debug compilation in production, set:
      COMPILATION_DEBUG=false
    rather than using a Web.Release.config XDT transform on <compilation>.

    Example: to configure production connection strings, set:
      DB_CONNECTION_STRING=Server=<rds-proxy>;Database=tourdb;...
    rather than using a Web.Release.config XDT transform on <connectionStrings>.
  -->
</configuration>
