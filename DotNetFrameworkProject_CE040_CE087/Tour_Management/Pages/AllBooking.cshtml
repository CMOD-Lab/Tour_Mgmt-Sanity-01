@page
@model Tour_Management.Pages.AllBookingModel
@*
    cr-dotnet-1034: Async GridView Data Binding with RDS via Entity Framework Core
    MIGRATION NOTE (cr-dotnet-0026 + cr-dotnet-1034): Migrated from ASP.NET Web Forms (allbooking.aspx)
    to ASP.NET Core Razor Pages with async data binding.
    - Line 15 (original): <asp:GridView runat="server"> synchronous server control
      → Replaced with async Razor foreach table rendering
    - Line 33 (original): <asp:SqlDataSource runat="server"> synchronous data source
      → Replaced with async EF Core OnGetAsync() using ToListAsync() on Amazon RDS
    - Removed: <%@ Register %> directive for System.Web.DataVisualization
    - Removed: runat="server" attributes (not supported in ASP.NET Core)
    - Added: @page and @model Razor Page directives
    - Data is now loaded in async Task OnGetAsync() via EF Core and rendered with Razor foreach loop
    - Prevents thread pool exhaustion under AWS cloud load; enables efficient auto-scaling
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>All Bookings</title>
    <style>
        table {
            border-collapse: collapse;
            width: 100%;
            background-color: white;
            border: 1px solid #DEDFDE;
            color: black;
        }
        th {
            background-color: #6B696B;
            color: white;
            font-weight: bold;
            padding: 4px;
        }
        td {
            background-color: #F7F7DE;
            text-align: center;
            padding: 4px;
        }
        tr:nth-child(even) td {
            background-color: white;
        }
    </style>
</head>
<body>
    <div>
        @*
            cr-dotnet-1034 (Line 15): Replaced synchronous <asp:GridView runat="server"> with async
            Razor foreach table. Data loaded via async Task OnGetAsync() using EF Core ToListAsync()
            connected to Amazon RDS - prevents thread pool exhaustion under cloud load.
        *@
        <table>
            <thead>
                <tr>
                    <th>TOUR_ID</th>
                    <th>TOUR_NAME</th>
                    <th>PLACE</th>
                    <th>Email</th>
                    <th>FirstName</th>
                </tr>
            </thead>
            <tbody>
                @*
                    cr-dotnet-1034 (Line 33): Replaced synchronous <asp:SqlDataSource> data binding
                    with async EF Core data loaded in OnGetAsync() and rendered here via Razor foreach.
                *@
                @if (Model.Bookings != null)
                {
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.TourId</td>
                            <td>@booking.TourName</td>
                            <td>@booking.Place</td>
                            <td>@booking.Email</td>
                            <td>@booking.FirstName</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</body>
</html>
