@page
@model Tour_Management.Pages.AllBookingModel
@{
    ViewData["Title"] = "All Bookings";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div>
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
                @Model.StatusMessage
            </div>
        }
    </div>

    <!-- Booking Grid Table — replaces asp:GridView with asp:SqlDataSource from Web Forms -->
    <!-- Original: asp:GridView DataKeyNames="TOUR_ID" DataSourceID="SqlDataSource1"       -->
    <!-- Original: asp:SqlDataSource SelectCommand="SELECT * FROM [booking]"               -->
    <table id="BookingGrid"
           style="background-color:white; border-color:#DEDFDE; border-style:None; border-width:1px; color:black; border-collapse:collapse; width:100%;">
        <thead>
            <tr style="background-color:#6B696B; color:white; font-weight:bold;">
                <th>TOUR_ID</th>
                <th>TOUR_NAME</th>
                <th>PLACE</th>
                <th>Email</th>
                <th>FirstName</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bookings != null)
            {
                bool alternate = false;
                foreach (var booking in Model.Bookings)
                {
                    string rowStyle = alternate ? "background-color:white; text-align:center;" : "background-color:#F7F7DE; text-align:center;";
                    alternate = !alternate;
                    <tr style="@rowStyle">
                        <td>@booking.TourId</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.Email</td>
                        <td>@booking.FirstName</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr style="background-color:#CCCC99;">
                <td colspan="5"></td>
            </tr>
        </tfoot>
    </table>
</body>
</html>
