@page
@model Tour_Management.Pages.MyBookingModel
@{
    ViewData["Title"] = "My Current Booking";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <h1>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; YOUR CURRENT BOOKING</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
            @Model.StatusMessage
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <!-- Booking Grid Table — replaces asp:GridView with asp:SqlDataSource from Web Forms -->
        <!-- Original: asp:GridView DataKeyNames="TOUR_ID" AutoGenerateDeleteButton="True"   -->
        <!-- Original: asp:SqlDataSource SelectCommand="SELECT [TOUR_NAME], [TOUR_ID] FROM [booking]" -->
        <!-- Original: asp:SqlDataSource DeleteCommand="Delete from [booking] Where [TOUR_ID]=@TOUR_ID" -->
        <table id="BookingGrid"
               style="background-color:white; border-color:#DEDFDE; border-style:None; border-width:1px; color:black; border-collapse:collapse; width:546px; margin-top:96px;">
            <thead>
                <tr style="background-color:#6B696B; color:white; font-weight:bold;">
                    <th>Delete</th>
                    <th>TOUR_NAME</th>
                    <th>ID</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bookings != null)
                {
                    bool alternate = false;
                    foreach (var booking in Model.Bookings)
                    {
                        string rowStyle = alternate ? "background-color:white; text-align:center;" : "background-color:#F7F7DE; text-align:center;";
                        alternate = !alternate;
                        <tr style="@rowStyle">
                            <td>
                                <button type="submit" asp-page-handler="Delete"
                                        onclick="return confirm('Delete this booking?');"
                                        style="background-color:#CE5D5A; color:white;">Delete</button>
                                <input type="hidden" name="deleteTourId" value="@booking.TourId" />
                            </td>
                            <td>@booking.TourName</td>
                            <td>@booking.TourId</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr style="background-color:#CCCC99;">
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
        <br />
    </form>
</body>
</html>
