@page
@model Tour_Management.Pages.MyBookingModel
@*
    cr-dotnet-1034: Async GridView Data Binding with RDS via Entity Framework Core
    MIGRATION NOTE (cr-dotnet-0026 + cr-dotnet-1034): Migrated from ASP.NET Web Forms (mybooking.aspx)
    to ASP.NET Core Razor Pages with async data binding.
    - Line 12 (original): <asp:GridView AutoGenerateDeleteButton="True" runat="server"> synchronous server control
      → Replaced with async Razor foreach table rendering
    - Removed: <asp:SqlDataSource runat="server"> synchronous data source
      → Replaced with async EF Core OnGetAsync() using ToListAsync() on Amazon RDS
    - Removed: runat="server" attributes (not supported in ASP.NET Core)
    - Added: @page and @model Razor Page directives
    - Data is now loaded in async Task OnGetAsync() via EF Core and rendered with Razor foreach loop
    - Delete action migrated to async OnPostDeleteAsync() handler with AntiForgeryToken protection
    - Prevents thread pool exhaustion under AWS cloud load; enables efficient auto-scaling
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>My Bookings</title>
    <style>
        h1 {
            text-align: center;
        }
        table {
            border-collapse: collapse;
            width: 546px;
            background-color: white;
            border: 1px solid #DEDFDE;
            color: black;
            margin-top: 96px;
        }
        th {
            background-color: #6B696B;
            color: white;
            font-weight: bold;
            padding: 4px;
        }
        td {
            background-color: #F7F7DE;
            text-align: center;
            padding: 4px;
        }
        tr:nth-child(even) td {
            background-color: white;
        }
    </style>
</head>
<body>
    <h1>YOUR CURRENT BOOKING</h1>
    @*
        cr-dotnet-1034 (Line 12): Replaced synchronous <asp:GridView AutoGenerateDeleteButton="True">
        server control with async Razor foreach table. Data loaded via async Task OnGetAsync()
        using EF Core ToListAsync() connected to Amazon RDS.
        Delete action migrated to async OnPostDeleteAsync() handler.
    *@
    <form method="post" asp-page-handler="Delete">
        @Html.AntiForgeryToken()
        <table>
            <thead>
                <tr>
                    <th>TOUR_NAME</th>
                    <th>ID</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bookings != null)
                {
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.TourName</td>
                            <td>@booking.TourId</td>
                            <td>
                                <button type="submit" name="tourId" value="@booking.TourId"
                                        style="background-color:#CE5D5A; color:white; border:none; cursor:pointer;">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </form>
</body>
</html>
