@page
@model Tour_Management.Pages.MyBookingModel
@*
    MIGRATION NOTE (cr-dotnet-0026):
    Migrated from ASP.NET Web Forms (mybooking.aspx) to ASP.NET Core Razor Pages.
    - Removed: <%@ Page %> directive, runat="server" attributes
    - Removed: <asp:GridView> data-bound server control — replaced with Razor @foreach HTML table
    - Removed: <asp:SqlDataSource> declarative data source with ConnectionString="<%$ ConnectionStrings:dbconnection %>"
    - Removed: <asp:BoundField> column definitions
    - Removed: AutoGenerateDeleteButton="True", DataKeyNames="TOUR_ID", DataSourceID="SqlDataSource1" GridView bindings
    - Removed: <form id="form1" runat="server"> Web Forms postback form
    - Replaced: <asp:GridView> with standard HTML <table> rendered via @foreach over @Model.Bookings
    - Replaced: <asp:SqlDataSource> SelectCommand with OnGetAsync() EF Core query populating @Model.Bookings
    - Replaced: <asp:SqlDataSource> DeleteCommand with OnPostDeleteAsync() Razor Page handler
    - cr-dotnet-1034: Updated to use typed MyBookingEntity properties (EF Core) instead of dynamic Dapper results
    - Navigation links updated to use ASP.NET Core tag helpers (asp-page)
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>My Booking</title>
    <style>
        h1 {
            text-align: center;
        }
        table {
            width: 546px;
            border-collapse: collapse;
            background-color: white;
            border: 1px solid #DEDFDE;
            color: black;
            margin-top: 96px;
        }
        th {
            background-color: #6B696B;
            color: white;
            font-weight: bold;
            padding: 4px;
        }
        td {
            padding: 4px;
            text-align: center;
            background-color: #F7F7DE;
            border: 1px solid #DEDFDE;
        }
        tr:nth-child(even) td {
            background-color: white;
        }
        .btn-delete {
            margin: 2px;
            padding: 4px 8px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>YOUR CURRENT BOOKING</h1>
    @* Replaces <form id="form1" runat="server"> Web Forms postback form *@
    <div>
        @* Replaces <asp:GridView> with a standard HTML table rendered via Razor @foreach *@
        @* cr-dotnet-1034: Data now loaded asynchronously via EF Core OnGetAsync() *@
        <table>
            <thead>
                <tr>
                    @* Replaces <asp:BoundField DataField="TOUR_NAME" HeaderText="TOUR_NAME" /> *@
                    <th>TOUR_NAME</th>
                    @* Replaces <asp:BoundField DataField="TOUR_ID" HeaderText="ID" ReadOnly="True" /> *@
                    <th>ID</th>
                    @* Replaces AutoGenerateDeleteButton="True" *@
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Replaces <asp:GridView> row rendering — iterates over @Model.Bookings populated via EF Core async query *@
                @if (Model.Bookings != null)
                {
                    foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            @* cr-dotnet-1034: Using typed MyBookingEntity properties (EF Core) *@
                            <td>@booking.TourName</td>
                            <td>@booking.TourId</td>
                            <td>
                                @* Replaces AutoGenerateDeleteButton — delete form *@
                                <form method="post" asp-page-handler="Delete" asp-route-tourId="@booking.TourId" style="display:inline;">
                                    <button type="submit" class="btn-delete" onclick="return confirm('Delete this booking?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <br />
    </div>
</body>
</html>
