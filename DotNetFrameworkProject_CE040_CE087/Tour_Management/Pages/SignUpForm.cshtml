@page
@model Tour_Management.Pages.SignUpFormModel
@*
    MIGRATION NOTE (cr-dotnet-0026):
    Migrated from ASP.NET Web Forms (SignUpForm.aspx) to ASP.NET Core Razor Pages.
    - Removed: <%@ Page %> directive, runat="server" attributes, <asp:Label> server controls
    - Removed: <asp:TextBox>, <asp:Button>, <asp:DropDownList> Web Forms server controls
    - Removed: <form runat="server"> Web Forms postback form
    - Removed: OnClick="Register_Click" postback event handler
    - Replaced: Web Forms server controls with standard HTML form elements bound via Razor tag helpers
    - Replaced: Response.Write("Registration Successful") with @TempData["StatusMessage"] Razor binding
    - Replaced: Response.Redirect("userlogin.aspx") with RedirectToPage("/userlogin") in PageModel
    - Navigation links updated to use ASP.NET Core tag helpers (asp-page)
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>User Registration</title>
    <style>
        .container {
            text-align: center;
            background-color: black;
            width: 100%;
            font-size: 30px;
            color: white;
            padding-bottom: 150px;
            opacity: 0.8;
        }
    </style>
</head>
<body>
    <br />
    <br />

    @* Replaces <form runat="server"> Web Forms postback form with ASP.NET Core tag-helper form *@
    <form method="post">
        <div class="container">
            <div class="page-header">
                <h1>User Registration Form</h1>
            </div>

            @* Display status message — replaces Response.Write("Registration Successful") *@
            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert">@TempData["StatusMessage"]</div>
            }

            <div class="form-horizontal">
                <div class="form-group">
                    @* Replaces <asp:Label ID="Label1" runat="server" Text="Email"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="Email">Email</label>
                    </div>
                    @* Replaces <asp:TextBox ID="email" TextMode="Email" runat="server" required="true" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="Email" type="email" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label2" runat="server" Text="First Name"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="FirstName">First Name</label>
                    </div>
                    @* Replaces <asp:TextBox ID="fname" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="FirstName" type="text" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label3" runat="server" Text="Last Name"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="LastName">Last Name</label>
                    </div>
                    @* Replaces <asp:TextBox ID="lname" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="LastName" type="text" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label4" runat="server" Text="Gender"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="Gender">Gender</label>
                    </div>
                    @* Replaces <asp:DropDownList ID="gender" runat="server" Width="361px" ForeColor="Black" class="form-control"> *@
                    <div class="col-sm-6">
                        <select asp-for="Gender" class="form-control" style="color:black; width:361px;">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label5" runat="server" Text="Enter Password"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="Password1">Enter Password</label>
                    </div>
                    @* Replaces <asp:TextBox ID="password1" type="password" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="Password1" type="password" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label6" runat="server" Text="Re-enter Password"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="Password2">Re-enter Password</label>
                    </div>
                    @* Replaces <asp:TextBox ID="password2" type="password" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="Password2" type="password" required="required" class="form-control" style="color:black;" />
                    </div>
                    <br />
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label7" runat="server" Text="Date of birth(dd-mm-yyyy)"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="DateOfBirth">Date of birth (dd-mm-yyyy)</label>
                    </div>
                    @* Replaces <asp:TextBox ID="dob" required="true" runat="server" TextMode="Date" ForeColor="Black" class="form-control" Width="365px"/> *@
                    <div class="col-sm-6">
                        <input asp-for="DateOfBirth" type="date" required="required" class="form-control" style="color:black; width:365px;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label9" runat="server" Text="Street"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="Street">Street</label>
                    </div>
                    @* Replaces <asp:TextBox ID="street" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="Street" type="text" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label10" runat="server" Text="City"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="City">City</label>
                    </div>
                    @* Replaces <asp:TextBox ID="city" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="City" type="text" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Label ID="Label11" runat="server" Text="State"/> *@
                    <div class="control-label col-sm-4">
                        <label asp-for="State">State</label>
                    </div>
                    @* Replaces <asp:TextBox ID="state" required="true" runat="server" ForeColor="Black" class="form-control"/> *@
                    <div class="col-sm-6">
                        <input asp-for="State" type="text" required="required" class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    @* Replaces <asp:Button BackColor="#cc6600" ID="Register" runat="server" Text="Register" ForeColor="Black" class="form-control" OnClick="Register_Click" /> *@
                    <div class="control-label col-sm-2">
                        <button type="submit" class="form-control" style="background-color:#cc6600; color:black;">Register</button>
                    </div>
                    @* Replaces <asp:Button BackColor="#cc6600" ID="Reset" runat="server" Text="Reset" ForeColor="Black" class="form-control"/> *@
                    <div class="control-label col-sm-2">
                        <button type="reset" class="form-control" style="background-color:#cc6600; color:black;">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</body>
</html>
