@page
@model Tour_Management.Pages.UserLoginModel
@*
    MIGRATION NOTE (cr-dotnet-0026):
    Migrated from ASP.NET Web Forms (userlogin.aspx) to ASP.NET Core Razor Pages.
    - Removed: <%@ Page %> directive, runat="server" attributes (line 1)
    - Removed: <head runat="server">, <div runat="server">, <form id="form1" runat="server"> Web Forms server-side attributes
    - Removed: <asp:Label>, <asp:TextBox>, <asp:Button> Web Forms server controls
    - Removed: OnClick="Btn_Submit" and OnClick="Btn_reg" postback event handlers
    - Replaced: <asp:TextBox ID="txtEmail"> with <input asp-for="Email"> tag helper
    - Replaced: <asp:TextBox ID="txtPassword"> with <input asp-for="Password"> tag helper
    - Replaced: <asp:Button OnClick="Btn_Submit"> with <button asp-page-handler="Login">
    - Replaced: <asp:Button OnClick="Btn_reg"> with <button asp-page-handler="Register">
    - Added: @Model.StatusMessage display to replace Response.Write()
    - Navigation links updated to use ASP.NET Core tag helpers (asp-page)
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>User Login</title>
    <style type="text/css">
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            text-align: center;
            background-color: black;
            width: 100%;
            font-size: 30px;
            color: white;
            padding-bottom: 150px;
            opacity: 0.8;
        }
    </style>
    <script src="./script.js"></script>
    <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Rubik:400,700'>
</head>
<body>

    <br />
    <br />

    <div class="login-form">
        @* Replaces <div class="container" runat="server"> — removed runat="server" attribute *@
        <div class="container">
            <div class="page-header">
                <h1>User Login</h1>
            </div>

            @* Display status message — replaces Response.Write("Password is not correct") *@
            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert">@Model.StatusMessage</div>
            }

            @* Replaces <form id="form1" runat="server"> Web Forms postback form with ASP.NET Core tag-helper form *@
            <form method="post">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="control-label col-sm-4">
                            @* Replaces <asp:Label ID="Label1" runat="server" Text="Email" /> *@
                            <label asp-for="Email">Email</label>
                        </div>
                        <div class="col-sm-6">
                            @* Replaces <asp:TextBox ID="txtEmail" TextMode="Email" runat="server" required="true" ForeColor="Black" class="form-control" /> *@
                            <input asp-for="Email" type="email" required="required" class="form-control" style="color:black;" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="control-label col-sm-4">
                            @* Replaces <asp:Label ID="Label2" runat="server" Text="Password" /> *@
                            <label asp-for="Password">Password</label>
                        </div>
                        <div class="col-sm-6">
                            @* Replaces <asp:TextBox ID="txtPassword" type="password" required="true" runat="server" ForeColor="Black" class="form-control" /> *@
                            <input asp-for="Password" type="password" required="required" class="form-control" style="color:black;" />
                        </div>

                        @* Replaces <asp:Button BackColor="#cc6600" ID="Register" runat="server" Text="Login" ForeColor="Black" class="form-control" OnClick="Btn_Submit" Height="35px" Width="92px" /> *@
                        <div class="control-label col-sm-2">
                            <button type="submit" asp-page-handler="Login" class="form-control" style="background-color:#cc6600; color:black; height:35px; width:92px;">Login</button>
                        </div>
                        @* Replaces <asp:Button BackColor="#cc6600" ID="Button1" runat="server" Text="Sign Up" ForeColor="Black" class="form-control" OnClick="Btn_reg" Height="38px" Width="137px" /> *@
                        <div class="control-label col-sm-2">
                            <button type="submit" asp-page-handler="Register" class="form-control" style="background-color:#cc6600; color:black; height:38px; width:137px;">Sign Up</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <p>
        &nbsp;</p>

</body>

</html>
