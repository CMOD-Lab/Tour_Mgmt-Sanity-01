@page
@model Tour_Management.Pages.UserLoginModel
@{
    ViewData["Title"] = "User Login";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
    <style type="text/css">
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            text-align: center;
            background-color: black;
            width: 100%;
            font-size: 30px;
            color: white;
            padding-bottom: 150px;
            opacity: 0.8;
        }
    </style>
    <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Rubik:400,700'>
</head>
<body>
    <br />
    <br />

    <div class="login-form">
        <div class="container">
            <div class="page-header">
                <h1>User Login</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
                    @Model.StatusMessage
                </div>
            }

            <!-- Login form — replaces asp:Label, asp:TextBox, asp:Button server controls
                 from original userlogin.aspx Web Forms page.
                 Btn_Submit handler migrated to OnPostLogin().
                 Btn_reg handler migrated to OnPostRegister(). -->
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="control-label col-sm-4">
                            <label asp-for="Input.Email">Email</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="Input.Email" type="email" required="true"
                                   class="form-control" style="color:black;" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="control-label col-sm-4">
                            <label asp-for="Input.Password">Password</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="Input.Password" type="password" required="true"
                                   class="form-control" style="color:black;" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="control-label col-sm-2">
                            <!-- Replaces: asp:Button ID="Register" OnClick="Btn_Submit" Text="Login" -->
                            <button type="submit" asp-page-handler="Login"
                                    class="form-control"
                                    style="background-color:#cc6600; color:black; height:35px; width:92px;">
                                Login
                            </button>
                        </div>
                        <div class="control-label col-sm-2">
                            <!-- Replaces: asp:Button ID="Button1" OnClick="Btn_reg" Text="Sign Up" -->
                            <button type="submit" asp-page-handler="Register"
                                    class="form-control"
                                    style="background-color:#cc6600; color:black; height:38px; width:137px;">
                                Sign Up
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <p>&nbsp;</p>
</body>
</html>
