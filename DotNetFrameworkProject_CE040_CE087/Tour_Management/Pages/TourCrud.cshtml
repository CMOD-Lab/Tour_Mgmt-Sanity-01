@page
@model Tour_Management.Pages.TourCrudModel
@{
    ViewData["Title"] = "Tour Management";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <h2>Tour Management</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert">@Model.StatusMessage</div>
    }

    <table border="1" cellpadding="4" style="background-color:white; border-color:#DEDFDE; color:black;">
        <thead style="background-color:#6B696B; color:white; font-weight:bold;">
            <tr>
                <th>TOUR_ID</th>
                <th>TOUR_NAME</th>
                <th>PLACE</th>
                <th>DAYS</th>
                <th>PRICE</th>
                <th>LOCATIONS</th>
                <th>TOUR_INFO</th>
                <th>Pic</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tour in Model.Tours)
            {
                <tr style="background-color:#F7F7DE; text-align:center;">
                    <td>@tour.TourId</td>
                    <td>@tour.TourName</td>
                    <td>@tour.Place</td>
                    <td>@tour.Days</td>
                    <td>@tour.Price</td>
                    <td>@tour.Locations</td>
                    <td>@tour.TourInfo</td>
                    <td><img src="~/Tour_pics/@tour.Pic" style="width:150px;height:150px;" /></td>
                    <td>
                        <form method="post" asp-page-handler="Edit">
                            <input type="hidden" name="tourId" value="@tour.TourId" />
                            <input type="text" name="tourName" value="@tour.TourName" />
                            <input type="text" name="place" value="@tour.Place" />
                            <input type="number" name="days" value="@tour.Days" />
                            <input type="text" name="price" value="@tour.Price" />
                            <input type="text" name="locations" value="@tour.Locations" />
                            <input type="text" name="tourInfo" value="@tour.TourInfo" />
                            <button type="submit" style="background-color:#cc6600;">Update</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Delete">
                            <input type="hidden" name="tourId" value="@tour.TourId" />
                            <button type="submit" style="background-color:#cc0000; color:white;">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
