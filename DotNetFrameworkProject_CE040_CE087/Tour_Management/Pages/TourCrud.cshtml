@page
@model Tour_Management.Pages.TourCrudModel
@*
    MIGRATION NOTE (cr-dotnet-0026):
    Migrated from ASP.NET Web Forms (TourCrud.aspx) to ASP.NET Core Razor Pages.
    - Removed: <%@ Page %> directive, runat="server" attributes
    - Removed: <asp:GridView> data-bound server control — replaced with Razor @foreach HTML table
    - Removed: <asp:SqlDataSource> declarative data source with ConnectionString="<%$ ConnectionStrings:dbconnection %>"
    - Removed: <asp:BoundField>, <asp:TemplateField> column definitions
    - Removed: AutoGenerateDeleteButton="True", AutoGenerateEditButton="True" GridView properties
    - Removed: DataKeyNames="TOUR_ID", DataSourceID="SqlDataSource1" GridView bindings
    - Removed: <form id="form1" runat="server"> Web Forms postback form
    - Replaced: <asp:GridView> with standard HTML <table> rendered via @foreach over @Model.Tours
    - Replaced: <asp:SqlDataSource> SelectCommand with OnGetAsync() EF Core query populating @Model.Tours
    - Replaced: <asp:SqlDataSource> UpdateCommand with OnPostUpdateAsync() Razor Page handler
    - Replaced: <asp:SqlDataSource> DeleteCommand with OnPostDeleteAsync() Razor Page handler
    - Replaced: <%#Eval("pic") %> data binding with @tour.Pic Razor expression
    - cr-dotnet-1034: Updated to use typed TourCrudEntity properties (EF Core) instead of dynamic Dapper results
    - Navigation links updated to use ASP.NET Core tag helpers (asp-page)
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Tour Management - CRUD</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            border: 1px solid #DEDFDE;
            color: black;
        }
        th {
            background-color: #6B696B;
            color: white;
            font-weight: bold;
            padding: 4px;
        }
        td {
            padding: 4px;
            text-align: center;
            background-color: #F7F7DE;
            border: 1px solid #DEDFDE;
        }
        tr:nth-child(even) td {
            background-color: white;
        }
        .btn-action {
            margin: 2px;
            padding: 4px 8px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    @* Replaces <form id="form1" runat="server"> Web Forms postback form *@
    @* cr-dotnet-1034: Data now loaded asynchronously via EF Core OnGetAsync() *@
    <form method="post">
        @* Replaces <asp:GridView> with a standard HTML table rendered via Razor @foreach *@
        <table>
            <thead>
                <tr>
                    <th>TOUR_ID</th>
                    <th>TOUR_NAME</th>
                    <th>PLACE</th>
                    <th>DAYS</th>
                    <th>PRICE</th>
                    <th>LOCATIONS</th>
                    <th>TOUR_INFO</th>
                    <th>pic</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Replaces <asp:GridView> row rendering — iterates over @Model.Tours populated via EF Core async query *@
                @if (Model.Tours != null)
                {
                    foreach (var tour in Model.Tours)
                    {
                        <tr>
                            @* Replaces <asp:BoundField DataField="TOUR_ID" ReadOnly="True" /> *@
                            @* cr-dotnet-1034: Using typed TourCrudEntity properties (EF Core) *@
                            <td>@tour.TourId</td>
                            @* Replaces <asp:BoundField DataField="TOUR_NAME" /> *@
                            <td>@tour.TourName</td>
                            @* Replaces <asp:BoundField DataField="PLACE" /> *@
                            <td>@tour.Place</td>
                            @* Replaces <asp:BoundField DataField="DAYS" /> *@
                            <td>@tour.Days</td>
                            @* Replaces <asp:BoundField DataField="PRICE" /> *@
                            <td>@tour.Price</td>
                            @* Replaces <asp:BoundField DataField="LOCATIONS" /> *@
                            <td>@tour.Locations</td>
                            @* Replaces <asp:BoundField DataField="TOUR_INFO" /> *@
                            <td>@tour.TourInfo</td>
                            @* Replaces <asp:TemplateField HeaderText="pic"> <ItemTemplate> <img src="Tour_pics/<%#Eval("pic") %>" /> *@
                            <td>
                                <img src="~/Tour_pics/@tour.Pic" style="width:150px;height:150px" alt="Tour Image" />
                            </td>
                            <td>
                                @* Replaces AutoGenerateEditButton — inline edit form *@
                                <form method="post" asp-page-handler="Update" style="display:inline;">
                                    <input type="hidden" name="TourId" value="@tour.TourId" />
                                    <input type="text" name="TourName" value="@tour.TourName" class="btn-action" />
                                    <input type="text" name="Place" value="@tour.Place" class="btn-action" />
                                    <input type="number" name="Days" value="@tour.Days" class="btn-action" style="width:60px;" />
                                    <input type="number" name="Price" value="@tour.Price" class="btn-action" style="width:80px;" step="0.01" />
                                    <input type="text" name="Locations" value="@tour.Locations" class="btn-action" />
                                    <input type="text" name="TourInfo" value="@tour.TourInfo" class="btn-action" />
                                    <button type="submit" class="btn-action">Update</button>
                                </form>
                                @* Replaces AutoGenerateDeleteButton — delete form *@
                                <form method="post" asp-page-handler="Delete" asp-route-tourId="@tour.TourId" style="display:inline;">
                                    <button type="submit" class="btn-action" onclick="return confirm('Delete this tour?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </form>
</body>
</html>
