@page
@model Tour_Management.Pages.SignUpFormModel
@{
    ViewData["Title"] = "User Registration Form";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
    <style>
        .container {
            text-align: center;
            background-color: black;
            width: 100%;
            font-size: 30px;
            color: white;
            padding-bottom: 150px;
            opacity: 0.8;
        }
    </style>
</head>
<body>
    <br />
    <br />

    <div class="container">
        <div class="page-header">
            <h1>User Registration Form</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert">@Model.StatusMessage</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="Email">Email</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="Email" name="Email" type="email" required="required"
                               class="form-control" style="color:black;"
                               value="@Model.Email" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="FirstName">First Name</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="FirstName" name="FirstName" type="text" required="required"
                               class="form-control" style="color:black;"
                               value="@Model.FirstName" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="LastName">Last Name</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="LastName" name="LastName" type="text" required="required"
                               class="form-control" style="color:black;"
                               value="@Model.LastName" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="Gender">Gender</label>
                    </div>
                    <div class="col-sm-6">
                        <select id="Gender" name="Gender" class="form-control" style="color:black; width:361px;">
                            <option value="Male" @(Model.Gender == "Male" ? "selected" : "")>Male</option>
                            <option value="Female" @(Model.Gender == "Female" ? "selected" : "")>Female</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="Password">Enter Password</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="Password" name="Password" type="password" required="required"
                               class="form-control" style="color:black;" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="ConfirmPassword">Re-enter Password</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" required="required"
                               class="form-control" style="color:black;" />
                    </div>
                    <br />
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="Dob">Date of birth (dd-mm-yyyy)</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="Dob" name="Dob" type="date" required="required"
                               class="form-control" style="color:black; width:365px;"
                               value="@Model.Dob" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="Street">Street</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="Street" name="Street" type="text" required="required"
                               class="form-control" style="color:black;"
                               value="@Model.Street" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="City">City</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="City" name="City" type="text" required="required"
                               class="form-control" style="color:black;"
                               value="@Model.City" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label for="State">State</label>
                    </div>
                    <div class="col-sm-6">
                        <input id="State" name="State" type="text" required="required"
                               class="form-control" style="color:black;"
                               value="@Model.State" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-2">
                        <button type="submit" name="handler" value="Register"
                                style="background-color:#cc6600; color:black;" class="form-control">
                            Register
                        </button>
                    </div>
                    <div class="control-label col-sm-2">
                        <button type="reset"
                                style="background-color:#cc6600; color:black;" class="form-control">
                            Reset
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>
