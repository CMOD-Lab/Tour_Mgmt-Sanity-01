@*
    Razor View replacing userlogin.aspx Web Form.
    Migrated from ASP.NET Web Forms to ASP.NET MVC Razor View.
    Original: userlogin.aspx + userlogin.aspx.cs (System.Web.UI.Page)
    Replaced by: UserController.Login (GET/POST) + this view
    Rule: cr-dotnet-0026 - Web Forms Usage
*@
@model Tour_Management.Models.UserLoginViewModel
@{
    ViewBag.Title = "User Login";
}

<style type="text/css">
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-font-smoothing: antialiased;
    }

    .container {
        text-align: center;
        background-color: black;
        width: 100%;
        font-size: 30px;
        color: white;
        padding-bottom: 150px;
        opacity: 0.8;
    }
</style>

<br />
<br />

<div class="login-form">
    <div class="container">
        <div class="page-header">
            <h1>User Login</h1>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        @using (Html.BeginForm("Login", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <div class="form-group">
                    <div class="control-label col-sm-4">@Html.LabelFor(m => m.Email)</div>
                    <div class="col-sm-6">@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "true" })</div>
                </div>
                <div class="form-group">
                    <div class="control-label col-sm-4">@Html.LabelFor(m => m.Password)</div>
                    <div class="col-sm-6">@Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "true" })</div>
                    <div class="control-label col-sm-2">
                        <button type="submit" class="form-control" style="background-color:#cc6600; color:black; height:35px; width:92px;">Login</button>
                    </div>
                    <div class="control-label col-sm-2">
                        @Html.ActionLink("Sign Up", "SignUp", "User", null, new { @class = "form-control btn", style = "background-color:#cc6600; color:black; height:38px; width:137px;" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>
