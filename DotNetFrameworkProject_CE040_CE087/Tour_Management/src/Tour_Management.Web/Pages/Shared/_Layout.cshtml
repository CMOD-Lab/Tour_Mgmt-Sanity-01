@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <i class="bi bi-airplane-fill"></i> Tour Management
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Tours/Index">Tours</a>
                    </li>
                    @if (HttpContextAccessor.HttpContext?.Session.GetString("UserEmail") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/MyBookings">My Bookings</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (HttpContextAccessor.HttpContext?.Session.GetString("UserEmail") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Profile">
                                <i class="bi bi-person-circle"></i> @HttpContextAccessor.HttpContext?.Session.GetString("UserEmail")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Logout">Logout</a>
                        </li>
                    }
                    else if (HttpContextAccessor.HttpContext?.Session.GetString("AdminEmail") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Dashboard">
                                <i class="bi bi-shield-fill"></i> Admin
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Login">Admin</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer mt-5 py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year Tour Management System. All rights reserved.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
