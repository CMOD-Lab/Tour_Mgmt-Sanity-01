@page
@model Tour_Management.Web.Pages.Admin.ProfileModel
@{
    ViewData["Title"] = "Admin Profile";
}

<div class="jumbotron p-5 mb-4 rounded-3" style="background: linear-gradient(135deg, #1a1a2e, #16213e); color: white;">
    <h1 class="display-5">Welcome to the Admin Section</h1>
    <p class="lead">You can manage the admin work here. You can add tours and places for customers.</p>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card text-center shadow mb-3">
            <div class="card-body">
                <h5 class="card-title">Add Tours</h5>
                <a asp-page="/Tours/Create" class="btn btn-primary">Add New Tour</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow mb-3">
            <div class="card-body">
                <h5 class="card-title">Manage Tours</h5>
                <a asp-page="/Tours/Manage" class="btn btn-warning">Manage Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow mb-3">
            <div class="card-body">
                <h5 class="card-title">All Bookings</h5>
                <a asp-page="/Bookings/AllBookings" class="btn btn-success">View Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow mb-3">
            <div class="card-body">
                <h5 class="card-title">Manage Users</h5>
                <a asp-page="/Users/Manage" class="btn btn-info">Manage Users</a>
            </div>
        </div>
    </div>
</div>
