@page
@model Tour_Management.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Confirm Tour Booking";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mt-4" style="background-color: #1a1a2e; color: white;">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">Confirm Tour</h2>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" type="tel" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Book Tour</button>
                        <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
