@page
@model Tour_Management.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<h1><i class="bi bi-calendar-check"></i> My Bookings</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> You have no bookings yet.
        <a asp-page="/Tours/Index">Browse tours to book one!</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (booking.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-primary btn-sm">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <form method="post" asp-page-handler="Cancel" style="display:inline;">
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Cancel this booking?')">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
