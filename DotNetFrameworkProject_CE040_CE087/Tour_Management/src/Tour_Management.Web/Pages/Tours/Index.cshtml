@page
@model Tour_Management.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<h2>Available Tours</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="mb-3">
    <form method="get" class="d-flex">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control me-2" placeholder="Search tours..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="/Tours/Index" class="btn btn-secondary ms-2">Clear</a>
        }
    </form>
</div>

<div class="row">
    @foreach (var tour in Model.Tours)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                @if (!string.IsNullOrEmpty(tour.Pic))
                {
                    <img src="/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h5 class="card-title">@tour.TourName</h5>
                    <p class="card-text">
                        <strong>Place:</strong> @tour.Place<br />
                        <strong>Days:</strong> @tour.Days<br />
                        <strong>Price:</strong> @tour.Price.ToString("C")<br />
                        <strong>Locations:</strong> @tour.Locations
                    </p>
                </div>
                <div class="card-footer">
                    <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                    <a asp-page="/Bookings/Create" asp-route-tourName="@tour.TourName" class="btn btn-success btn-sm">Book Now</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found.</div>
}
