@page
@model Tour_Management.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-map"></i> Tours</h1>
    @if (HttpContext.Session.GetString("AdminEmail") != null)
    {
        <a asp-page="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Tour
        </a>
    }
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours..." />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="Index" class="btn btn-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No tours found.
        @if (HttpContext.Session.GetString("AdminEmail") != null)
        {
            <a asp-page="Create">Add the first tour.</a>
        }
    </div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image text-white display-4"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted"><i class="bi bi-geo-alt"></i> @tour.Place</p>
                        <p class="card-text"><i class="bi bi-calendar"></i> @tour.Days days</p>
                        <p class="card-text"><strong class="text-success">₹@tour.Price.ToString("N2")</strong></p>
                        <p class="card-text small text-muted">@(tour.TourInfo.Length > 80 ? tour.TourInfo.Substring(0, 80) + "..." : tour.TourInfo)</p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye"></i> Details
                        </a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success btn-sm">
                            <i class="bi bi-calendar-plus"></i> Book
                        </a>
                        @if (HttpContext.Session.GetString("AdminEmail") != null)
                        {
                            <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
