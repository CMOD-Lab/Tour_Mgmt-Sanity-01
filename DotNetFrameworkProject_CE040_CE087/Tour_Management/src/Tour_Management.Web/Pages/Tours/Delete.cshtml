@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h2>Delete Tour</h2>

@if (Model.Tour != null)
{
    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this tour?</h4>
    </div>

    <div class="card shadow mt-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Tour.TourName</dd>

                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@Model.Tour.Price.ToString("C")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form method="post">
                <input type="hidden" name="id" value="@Model.Tour.TourId" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-page="/Tours/Manage" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Manage" class="btn btn-secondary">Back to Manage</a>
}
