@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-danger">Tour not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/Tour_pics/@Model.Tour.Pic" class="img-fluid rounded" alt="@Model.Tour.TourName" onerror="this.src='/images/default-tour.jpg'" />
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                    <i class="bi bi-image text-white display-1"></i>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1>@Model.Tour.TourName</h1>
            <table class="table table-bordered mt-3">
                <tr>
                    <th><i class="bi bi-geo-alt"></i> Place</th>
                    <td>@Model.Tour.Place</td>
                </tr>
                <tr>
                    <th><i class="bi bi-calendar"></i> Duration</th>
                    <td>@Model.Tour.Days days</td>
                </tr>
                <tr>
                    <th><i class="bi bi-currency-rupee"></i> Price</th>
                    <td><strong class="text-success">₹@Model.Tour.Price.ToString("N2")</strong></td>
                </tr>
                <tr>
                    <th><i class="bi bi-pin-map"></i> Locations</th>
                    <td>@Model.Tour.Locations</td>
                </tr>
            </table>
            <h5>Tour Information</h5>
            <p>@Model.Tour.TourInfo</p>
            <div class="mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success btn-lg">
                    <i class="bi bi-calendar-plus"></i> Book This Tour
                </a>
                <a asp-page="Index" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left"></i> Back to Tours
                </a>
                @if (HttpContext.Session.GetString("AdminEmail") != null)
                {
                    <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning ms-2">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                }
            </div>
        </div>
    </div>
}
