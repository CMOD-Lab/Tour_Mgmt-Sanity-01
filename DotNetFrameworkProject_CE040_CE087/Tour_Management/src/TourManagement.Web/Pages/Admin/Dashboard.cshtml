@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

@if (!Model.IsAdmin)
{
    <div class="alert alert-danger">
        Access denied. Please <a asp-page="Login">login as admin</a>.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Admin Dashboard</h1>
        <a asp-page="Logout" class="btn btn-outline-danger">Logout</a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body text-center">
                    <h2>@Model.TotalTours</h2>
                    <p class="card-text">Total Tours</p>
                    <a asp-page="/Tours/Index" class="btn btn-light btn-sm">Manage Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body text-center">
                    <h2>@Model.TotalBookings</h2>
                    <p class="card-text">Total Bookings</p>
                    <a asp-page="/Bookings/Index" class="btn btn-light btn-sm">View Bookings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3">
                <div class="card-body text-center">
                    <h2>@Model.TotalUsers</h2>
                    <p class="card-text">Registered Users</p>
                    <a asp-page="Users" class="btn btn-light btn-sm">Manage Users</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Quick Actions</div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Tours/Create" class="btn btn-primary">Add New Tour</a>
                        <a asp-page="/Bookings/Index" class="btn btn-success">View All Bookings</a>
                        <a asp-page="/Tours/Index" class="btn btn-info">Manage Tours</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
