@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<hr />

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Tours</h5>
                <p class="card-text display-4">@Model.TotalTours</p>
                <a asp-page="/Tours/Index" class="btn btn-light btn-sm">Manage Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Bookings</h5>
                <p class="card-text display-4">@Model.TotalBookings</p>
                <a asp-page="/Bookings/Index" class="btn btn-light btn-sm">View Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <p class="card-text display-4">@Model.TotalUsers</p>
                <a asp-page="/Users/Index" class="btn btn-light btn-sm">Manage Users</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Quick Actions</h5>
            </div>
            <div class="card-body">
                <a asp-page="/Tours/Create" class="btn btn-primary mb-2 w-100">Add New Tour</a>
                <a asp-page="/Bookings/Index" class="btn btn-success mb-2 w-100">View All Bookings</a>
                <a asp-page="/Users/Index" class="btn btn-info mb-2 w-100">View All Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Recent Bookings</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentBookings.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Tour</th>
                                <th>Customer</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td>@booking.TourName</td>
                                    <td>@booking.FirstName</td>
                                    <td>@booking.CreatedDate.ToString("MMM dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No recent bookings.</p>
                }
            </div>
        </div>
    </div>
</div>
