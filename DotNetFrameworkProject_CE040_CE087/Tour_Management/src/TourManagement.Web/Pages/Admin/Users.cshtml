@page
@model TourManagement.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

@if (!Model.IsAdmin)
{
    <div class="alert alert-danger">Access denied.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Manage Users</h1>
        <a asp-page="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    @if (!Model.Users.Any())
    {
        <div class="alert alert-info">No users found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>City</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>@user.Gender</td>
                            <td>@user.City</td>
                            <td>@user.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-page="/Users/Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
