@page "{id:int}"
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>
<hr />

@if (Model.UserToDelete == null)
{
    <div class="alert alert-warning">User not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Users</a>
}
else
{
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this user?</h4>
        <p>This action cannot be undone.</p>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.UserToDelete.FullName</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.UserToDelete.Email</dd>
                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Model.UserToDelete.City</dd>
            </dl>
        </div>
    </div>

    <form method="post">
        <input type="hidden" name="id" value="@Model.UserToDelete.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}
