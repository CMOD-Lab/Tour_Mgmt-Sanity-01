@page "{id:int}"
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <h1 class="text-danger mb-4">Delete User</h1>
    @if (Model.UserName == null)
    {
        <div class="alert alert-warning">User not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    }
    else
    {
        <div class="alert alert-danger">
            <h4><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h4>
            <p>Are you sure you want to delete user <strong>@Model.UserName</strong> (@Model.UserEmail)?</p>
        </div>
        <form method="post">
            <input type="hidden" asp-for="UserId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    }
</div>
