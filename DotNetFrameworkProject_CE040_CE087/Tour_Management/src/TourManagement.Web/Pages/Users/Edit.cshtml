@page "{id:int}"
@model TourManagement.Web.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1>Edit Profile</h1>
        <hr />
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="User.Id" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="User.FirstName" class="form-label"></label>
                    <input asp-for="User.FirstName" class="form-control" />
                    <span asp-validation-for="User.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="User.LastName" class="form-label"></label>
                    <input asp-for="User.LastName" class="form-control" />
                    <span asp-validation-for="User.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="User.Email" class="form-label">Email Address</label>
                <input asp-for="User.Email" class="form-control" />
                <span asp-validation-for="User.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="User.Gender" class="form-label">Gender</label>
                <select asp-for="User.Gender" class="form-select">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="User.Gender" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="User.DateOfBirth" class="form-label"></label>
                <input asp-for="User.DateOfBirth" class="form-control" type="date" />
            </div>

            <div class="mb-3">
                <label asp-for="User.Street" class="form-label">Street Address</label>
                <input asp-for="User.Street" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="User.City" class="form-label">City</label>
                    <input asp-for="User.City" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="User.State" class="form-label">State</label>
                    <input asp-for="User.State" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="Profile" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
