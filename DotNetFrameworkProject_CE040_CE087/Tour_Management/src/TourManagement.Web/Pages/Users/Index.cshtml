@page
@model TourManagement.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "All Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>All Users</h1>
</div>

@if (!Model.Users.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>@user.Gender</td>
                        <td>@user.City</td>
                        <td>@user.State</td>
                        <td>@user.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
