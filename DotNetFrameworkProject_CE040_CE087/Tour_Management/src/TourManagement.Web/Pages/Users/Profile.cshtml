@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    @if (Model.Profile == null)
    {
        <div class="alert alert-warning">
            Please <a asp-page="Login">login</a> to view your profile.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm text-center">
                    <div class="card-body py-4">
                        <i class="bi bi-person-circle text-primary" style="font-size: 5rem;"></i>
                        <h4 class="mt-3">@Model.Profile.FullName</h4>
                        <p class="text-muted">@Model.Profile.Email</p>
                        <span class="badge bg-@(Model.Profile.Role == "Admin" ? "danger" : "primary")">
                            @Model.Profile.Role
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Profile Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Full Name</dt>
                            <dd class="col-sm-8">@Model.Profile.FullName</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Profile.Email</dd>

                            @if (!string.IsNullOrEmpty(Model.Profile.Gender))
                            {
                                <dt class="col-sm-4">Gender</dt>
                                <dd class="col-sm-8">@Model.Profile.Gender</dd>
                            }

                            @if (Model.Profile.DateOfBirth.HasValue)
                            {
                                <dt class="col-sm-4">Date of Birth</dt>
                                <dd class="col-sm-8">@Model.Profile.DateOfBirth.Value.ToString("dd MMM yyyy")</dd>
                            }

                            @if (!string.IsNullOrEmpty(Model.Profile.Street))
                            {
                                <dt class="col-sm-4">Address</dt>
                                <dd class="col-sm-8">
                                    @Model.Profile.Street
                                    @if (!string.IsNullOrEmpty(Model.Profile.City))
                                    {
                                        <span>, @Model.Profile.City</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Profile.State))
                                    {
                                        <span>, @Model.Profile.State</span>
                                    }
                                </dd>
                            }
                        </dl>
                    </div>
                </div>

                <div class="card shadow-sm mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">My Bookings</h5>
                        <a asp-page="/Bookings/MyBookings" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        @if (!Model.RecentBookings.Any())
                        {
                            <p class="text-muted">No bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to book one!</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Tour</th>
                                            <th>Place</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var booking in Model.RecentBookings)
                                        {
                                            <tr>
                                                <td>@booking.TourName</td>
                                                <td>@booking.Place</td>
                                                <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-page="Logout" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </div>
    }
</div>
