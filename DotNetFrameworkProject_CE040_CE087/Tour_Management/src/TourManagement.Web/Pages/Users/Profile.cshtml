@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (Model.Profile != null)
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Profile Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.Profile.FullName</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Profile.Email</dd>
                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.Profile.Gender</dd>
                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@Model.Profile.DateOfBirth.ToString("MMMM dd, yyyy")</dd>
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.Profile.Street, @Model.Profile.City, @Model.Profile.State</dd>
                    </dl>
                    <a asp-page="Edit" asp-route-id="@Model.Profile.Id" class="btn btn-primary">Edit Profile</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Links</h5>
                </div>
                <div class="card-body">
                    <a asp-page="/Bookings/MyBookings" class="btn btn-outline-primary w-100 mb-2">My Bookings</a>
                    <a asp-page="/Tours/Index" class="btn btn-outline-success w-100 mb-2">Browse Tours</a>
                    <a asp-page="Logout" class="btn btn-outline-danger w-100">Logout</a>
                </div>
            </div>
        </div>
    </div>
}
