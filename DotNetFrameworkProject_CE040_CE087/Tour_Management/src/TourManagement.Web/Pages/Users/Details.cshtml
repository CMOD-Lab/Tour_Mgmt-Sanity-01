@page "{id:int}"
@model TourManagement.Web.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">
    @if (Model.User == null)
    {
        <div class="alert alert-warning">User not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back to Users</a>
    }
    else
    {
        <h1 class="mb-4">User Details</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Full Name</dt>
                    <dd class="col-sm-9">@Model.User.FullName</dd>
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.User.Email</dd>
                    <dt class="col-sm-3">Gender</dt>
                    <dd class="col-sm-9">@(Model.User.Gender ?? "N/A")</dd>
                    <dt class="col-sm-3">Date of Birth</dt>
                    <dd class="col-sm-9">@(Model.User.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A")</dd>
                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">@($"{Model.User.Street}, {Model.User.City}, {Model.User.State}".Trim(',', ' '))</dd>
                    <dt class="col-sm-3">Role</dt>
                    <dd class="col-sm-9"><span class="badge bg-primary">@Model.User.Role</span></dd>
                </dl>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <a asp-page="Edit" asp-route-id="@Model.User.Id" class="btn btn-warning">Edit</a>
            <a asp-page="Delete" asp-route-id="@Model.User.Id" class="btn btn-danger">Delete</a>
            <a asp-page="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    }
</div>
