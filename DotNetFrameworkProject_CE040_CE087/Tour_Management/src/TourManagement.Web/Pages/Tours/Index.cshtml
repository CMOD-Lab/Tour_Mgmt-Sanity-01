@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "All Tours";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>All Tours</h1>
        @if (HttpContext.Session.GetString("IsAdmin") == "true")
        {
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Tour
            </a>
        }
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control"
                   placeholder="Search tours by name, place, or locations..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Tours.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <span>No tours found matching "@Model.SearchTerm".</span>
            }
            else
            {
                <span>No tours available at this time.</span>
            }
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(tour.PictureName))
                        {
                            <img src="/Tour_pics/@tour.PictureName" class="card-img-top" alt="@tour.TourName"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <i class="bi bi-image text-secondary fs-1"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @tour.Place
                            </p>
                            <p class="card-text">
                                <i class="bi bi-clock text-info"></i> @tour.Days days
                            </p>
                            <p class="card-text fw-bold text-primary fs-5">₹@tour.Price.ToString("N2")</p>
                            <p class="card-text text-muted small">
                                <i class="bi bi-pin-map"></i> @tour.Locations
                            </p>
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-primary flex-fill">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id"
                               asp-route-tourName="@tour.TourName" asp-route-place="@tour.Place"
                               class="btn btn-success flex-fill">
                                <i class="bi bi-calendar-plus"></i> Book
                            </a>
                            @if (HttpContext.Session.GetString("IsAdmin") == "true")
                            {
                                <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
