@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tours</h1>
    <a asp-page="Create" class="btn btn-primary">+ Add New Tour</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name, place or location..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="Index" class="btn btn-outline-danger">Clear</a>
        }
    </div>
</form>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found.</div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/tour-images/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted"><i class="bi bi-geo-alt"></i> @tour.Place</p>
                        <p class="card-text">
                            <span class="badge bg-info">@tour.Days days</span>
                            <span class="badge bg-success">₹@tour.Price.ToString("N0")</span>
                        </p>
                        @if (!string.IsNullOrEmpty(tour.TourInfo))
                        {
                            <p class="card-text small">@(tour.TourInfo.Length > 80 ? tour.TourInfo[..80] + "..." : tour.TourInfo)</p>
                        }
                    </div>
                    <div class="card-footer d-flex gap-1">
                        <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-outline-primary btn-sm">Details</a>
                        <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-outline-warning btn-sm">Edit</a>
                        <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success btn-sm ms-auto">Book</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
