@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Add New Tour";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Tours</a></li>
            <li class="breadcrumb-item active">Add New Tour</li>
        </ol>
    </nav>

    <h1 class="mb-4">Add New Tour</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="TourInput.TourName" class="form-label fw-bold"></label>
                            <input asp-for="TourInput.TourName" class="form-control" placeholder="Enter tour name" />
                            <span asp-validation-for="TourInput.TourName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TourInput.Place" class="form-label fw-bold"></label>
                            <input asp-for="TourInput.Place" class="form-control" placeholder="Enter destination" />
                            <span asp-validation-for="TourInput.Place" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TourInput.Days" class="form-label fw-bold"></label>
                                <input asp-for="TourInput.Days" class="form-control" type="number" min="1" max="365" />
                                <span asp-validation-for="TourInput.Days" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TourInput.Price" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="TourInput.Price" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="TourInput.Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TourInput.Locations" class="form-label fw-bold"></label>
                            <input asp-for="TourInput.Locations" class="form-control" placeholder="e.g., Delhi, Agra, Jaipur" />
                            <span asp-validation-for="TourInput.Locations" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TourInput.TourInfo" class="form-label fw-bold"></label>
                            <textarea asp-for="TourInput.TourInfo" class="form-control" rows="5"
                                      placeholder="Describe the tour..."></textarea>
                            <span asp-validation-for="TourInput.TourInfo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TourInput.PictureFile" class="form-label fw-bold"></label>
                            <input asp-for="TourInput.PictureFile" class="form-control" type="file"
                                   accept="image/*" />
                            <span asp-validation-for="TourInput.PictureFile" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Add Tour
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
