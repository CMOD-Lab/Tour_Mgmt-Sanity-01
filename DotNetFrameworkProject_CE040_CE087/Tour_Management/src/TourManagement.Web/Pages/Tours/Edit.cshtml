@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Tour.Id" />

            <div class="mb-3">
                <label asp-for="Tour.TourName" class="form-label"></label>
                <input asp-for="Tour.TourName" class="form-control" />
                <span asp-validation-for="Tour.TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tour.Place" class="form-label"></label>
                <input asp-for="Tour.Place" class="form-control" />
                <span asp-validation-for="Tour.Place" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Tour.Days" class="form-label">Number of Days</label>
                    <input asp-for="Tour.Days" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Tour.Days" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Tour.Price" class="form-label">Price (₹)</label>
                    <input asp-for="Tour.Price" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Tour.Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Tour.Locations" class="form-label">Locations</label>
                <input asp-for="Tour.Locations" class="form-control" />
                <span asp-validation-for="Tour.Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tour.TourInfo" class="form-label">Tour Information</label>
                <textarea asp-for="Tour.TourInfo" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Tour.TourInfo" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Tour.ExistingPicturePath))
            {
                <div class="mb-2">
                    <label class="form-label">Current Picture</label>
                    <div>
                        <img src="~/tour-images/@Model.Tour.ExistingPicturePath" style="max-height:150px;" class="img-thumbnail" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Tour.PictureFile" class="form-label">New Tour Picture (optional)</label>
                <input asp-for="Tour.PictureFile" class="form-control" type="file" accept="image/*" />
                <input type="hidden" asp-for="Tour.ExistingPicturePath" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Tour.IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="Tour.IsActive" class="form-check-label">Active</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
