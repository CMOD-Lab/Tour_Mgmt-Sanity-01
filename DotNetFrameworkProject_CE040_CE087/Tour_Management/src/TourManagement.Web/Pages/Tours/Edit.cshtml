@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.TourName" class="form-label"></label>
                <input asp-for="Input.TourName" class="form-control" />
                <span asp-validation-for="Input.TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Place" class="form-label"></label>
                <input asp-for="Input.Place" class="form-control" />
                <span asp-validation-for="Input.Place" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Days" class="form-label"></label>
                    <input asp-for="Input.Days" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Input.Days" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Price" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>
                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Locations" class="form-label"></label>
                <input asp-for="Input.Locations" class="form-control" />
                <span asp-validation-for="Input.Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TourInfo" class="form-label"></label>
                <textarea asp-for="Input.TourInfo" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                @if (!string.IsNullOrEmpty(Model.Input.ExistingPicturePath))
                {
                    <p>Current picture: <strong>@Model.Input.ExistingPicturePath</strong></p>
                    <img src="/images/tours/@Model.Input.ExistingPicturePath" class="img-thumbnail mb-2" style="max-height: 150px;" alt="Current tour picture" />
                    <input type="hidden" asp-for="Input.ExistingPicturePath" />
                }
                <label asp-for="Input.PictureFile" class="form-label">New Picture (leave empty to keep current)</label>
                <input asp-for="Input.PictureFile" class="form-control" type="file" accept="image/*" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="Input.IsActive" class="form-check-label">Active</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
