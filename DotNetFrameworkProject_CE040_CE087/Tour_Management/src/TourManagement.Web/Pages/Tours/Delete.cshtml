@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1>Delete Tour</h1>
<hr />

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="alert alert-danger">
        <strong>Warning!</strong> Are you sure you want to delete this tour?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Tour.TourName</dd>

        <dt class="col-sm-3">Place</dt>
        <dd class="col-sm-9">@Model.Tour.Place</dd>

        <dt class="col-sm-3">Days</dt>
        <dd class="col-sm-9">@Model.Tour.Days</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">₹@Model.Tour.Price.ToString("N0")</dd>
    </dl>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Tour.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
