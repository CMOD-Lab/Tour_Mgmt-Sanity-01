@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a Tour";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4><i class="bi bi-calendar-plus"></i> Book a Tour</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="BookingInput.TourName" class="form-label fw-bold"></label>
                            <input asp-for="BookingInput.TourName" class="form-control" readonly />
                            <span asp-validation-for="BookingInput.TourName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BookingInput.Place" class="form-label fw-bold"></label>
                            <input asp-for="BookingInput.Place" class="form-control" />
                            <span asp-validation-for="BookingInput.Place" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BookingInput.Email" class="form-label fw-bold"></label>
                            <input asp-for="BookingInput.Email" class="form-control" placeholder="Your email address" />
                            <span asp-validation-for="BookingInput.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BookingInput.FirstName" class="form-label fw-bold"></label>
                            <input asp-for="BookingInput.FirstName" class="form-control" placeholder="Your first name" />
                            <span asp-validation-for="BookingInput.FirstName" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="BookingInput.TourId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Confirm Booking
                            </button>
                            <a asp-page="/Tours/Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
