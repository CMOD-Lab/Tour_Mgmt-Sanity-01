@page
@model TourManagement.Web.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "All Bookings";
}

<div class="container mt-4">
    <h1 class="mb-4">All Bookings</h1>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control"
                   placeholder="Search by tour name or email..." />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Bookings.Any())
    {
        <div class="alert alert-info">No bookings found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Tour Name</th>
                        <th>Place</th>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.Id</td>
                            <td>@booking.TourName</td>
                            <td>@booking.Place</td>
                            <td>@booking.FirstName</td>
                            <td>@booking.Email</td>
                            <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
