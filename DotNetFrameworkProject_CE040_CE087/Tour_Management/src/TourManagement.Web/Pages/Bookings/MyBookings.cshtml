@page
@model TourManagement.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <h1 class="mb-4">My Bookings</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Bookings.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> You have no bookings yet.
            <a asp-page="/Tours/Index" class="alert-link">Browse tours</a> to book one!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Tour Name</th>
                        <th>Place</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.Id</td>
                            <td>@booking.TourName</td>
                            <td>@booking.Place</td>
                            <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-page="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Cancel
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
