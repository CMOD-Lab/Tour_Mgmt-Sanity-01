@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>
<hr />

@if (Model.Booking == null)
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="MyBookings" class="btn btn-secondary">Back to My Bookings</a>
}
else
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Booking.TourName</dd>
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Booking.Place</dd>
                <dt class="col-sm-3">Booked By</dt>
                <dd class="col-sm-9">@Model.Booking.FirstName</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Booking.Email</dd>
                <dt class="col-sm-3">Booked On</dt>
                <dd class="col-sm-9">@Model.Booking.CreatedDate.ToString("MMMM dd, yyyy")</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Booking.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="MyBookings" class="btn btn-secondary">Back to My Bookings</a>
        <a asp-page="/Tours/Index" class="btn btn-primary ms-2">Browse More Tours</a>
    </div>
}
