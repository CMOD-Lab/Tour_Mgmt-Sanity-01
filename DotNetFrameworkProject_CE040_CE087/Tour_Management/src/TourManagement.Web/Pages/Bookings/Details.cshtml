@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-4">
    @if (Model.Booking == null)
    {
        <div class="alert alert-warning">Booking not found.</div>
        <a asp-page="MyBookings" class="btn btn-secondary">Back</a>
    }
    else
    {
        <h1 class="mb-4">Booking Details</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Booking ID</dt>
                    <dd class="col-sm-9">#@Model.Booking.Id</dd>
                    <dt class="col-sm-3">Tour Name</dt>
                    <dd class="col-sm-9">@Model.Booking.TourName</dd>
                    <dt class="col-sm-3">Place</dt>
                    <dd class="col-sm-9">@Model.Booking.Place</dd>
                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">@Model.Booking.FirstName</dd>
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Booking.Email</dd>
                    <dt class="col-sm-3">Booking Date</dt>
                    <dd class="col-sm-9">@Model.Booking.BookingDate.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <a asp-page="Delete" asp-route-id="@Model.Booking.Id" class="btn btn-danger">Cancel Booking</a>
            <a asp-page="MyBookings" class="btn btn-outline-secondary">Back to My Bookings</a>
        </div>
    }
</div>
