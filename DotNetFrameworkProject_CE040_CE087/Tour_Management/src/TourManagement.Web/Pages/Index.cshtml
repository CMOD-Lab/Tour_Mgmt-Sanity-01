@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <div class="jumbotron bg-dark text-white p-5 rounded mb-4">
        <h1 class="display-4">Welcome to Tour Management</h1>
        <p class="lead">Discover amazing tours and book your dream vacation today!</p>
        <hr class="my-4" />
        <a class="btn btn-primary btn-lg" asp-page="/Tours/Index">Browse Tours</a>
        @if (HttpContext.Session.GetString("UserEmail") == null)
        {
            <a class="btn btn-outline-light btn-lg ms-2" asp-page="/Users/Register">Sign Up Free</a>
        }
    </div>

    @if (Model.FeaturedTours.Any())
    {
        <h2 class="mb-4">Featured Tours</h2>
        <div class="row">
            @foreach (var tour in Model.FeaturedTours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(tour.PicturePath))
                        {
                            <img src="/images/tours/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white fs-4">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text text-muted">@tour.Place</p>
                            <p class="card-text">@tour.Days days | <strong>$@tour.Price.ToString("N2")</strong></p>
                            <p class="card-text small">@(tour.TourInfo.Length > 100 ? tour.TourInfo[..100] + "..." : tour.TourInfo)</p>
                        </div>
                        <div class="card-footer">
                            <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary btn-sm">View Details</a>
                            <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success btn-sm ms-1">Book Now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
