@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home - Tour Management";
}

<div class="jumbotron text-center py-5 bg-primary text-white rounded mb-4">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your next adventure!</p>
    <a asp-page="/Tours/Index" class="btn btn-light btn-lg">Browse Tours</a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Explore Tours</h5>
                <p class="card-text">Browse our wide selection of tour packages to amazing destinations.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Book a Tour</h5>
                <p class="card-text">Register and book your favorite tour package easily.</p>
                <a asp-page="/Users/Register" class="btn btn-success">Register Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">My Bookings</h5>
                <p class="card-text">View and manage all your tour bookings in one place.</p>
                <a asp-page="/Bookings/MyBookings" class="btn btn-info">My Bookings</a>
            </div>
        </div>
    </div>
</div>

@if (Model.FeaturedTours.Any())
{
    <h2 class="mt-4">Featured Tours</h2>
    <div class="row">
        @foreach (var tour in Model.FeaturedTours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/tour-images/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">@tour.Place</p>
                        <p class="card-text"><strong>@tour.Days days</strong> | <strong class="text-success">₹@tour.Price.ToString("N0")</strong></p>
                        <p class="card-text small">@(tour.TourInfo?.Length > 100 ? tour.TourInfo[..100] + "..." : tour.TourInfo)</p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success btn-sm">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
