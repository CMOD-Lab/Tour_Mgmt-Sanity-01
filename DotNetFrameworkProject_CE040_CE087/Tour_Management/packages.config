<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" version="2.0.1" targetFramework="net472" />
  <!-- MSB3644 fix: Provides .NET Framework 4.7.2 reference assemblies for non-Windows/Linux builds -->
  <package id="Microsoft.NETFramework.ReferenceAssemblies" version="1.0.3" targetFramework="net472" developmentDependency="true" />
  <!-- MSB3644 fix: net472-specific reference assemblies package with actual DLLs and build targets -->
  <package id="Microsoft.NETFramework.ReferenceAssemblies.net472" version="1.0.3" targetFramework="net472" developmentDependency="true" />
  <!-- cz-dotnet-1032: AWS SDK packages for S3 file uploads via IRSA (no embedded credentials) -->
  <package id="AWSSDK.Core" version="3.7.400.69" targetFramework="net472" />
  <package id="AWSSDK.S3" version="3.7.413.3" targetFramework="net472" />
</packages>
