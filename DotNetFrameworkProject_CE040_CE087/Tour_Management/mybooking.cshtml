@page
@model Tour_Management.Pages.MyBookingModel
@{
    ViewData["Title"] = "My Current Booking";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewData["Title"]</title>
    <style type="text/css">
        h1 {
            text-align: center;
            margin-top: 40px;
        }

        table {
            width: 546px;
            border-collapse: collapse;
            background-color: white;
            border: 1px solid #DEDFDE;
            color: black;
            margin-top: 96px;
        }

        th {
            background-color: #6B696B;
            color: white;
            font-weight: bold;
            padding: 4px;
        }

        td {
            padding: 4px;
            text-align: center;
            background-color: #F7F7DE;
        }

        tr:nth-child(even) td {
            background-color: white;
        }

        tr.selected td {
            background-color: #CE5D5A;
            font-weight: bold;
            color: white;
        }

        .btn-delete {
            background-color: #CE5D5A;
            color: white;
            border: none;
            padding: 4px 8px;
            cursor: pointer;
        }

        .alert {
            padding: 10px;
            margin: 10px 0;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
    </style>
</head>
<body>
    <h1>YOUR CURRENT BOOKING</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "")">@Model.StatusMessage</div>
    }

    @if (Model.ErrorMessage != null)
    {
        <div class="alert">@Model.ErrorMessage</div>
    }
    else
    {
        <form method="post">
            @Html.AntiForgeryToken()
            <table>
                <thead>
                    <tr>
                        <th>TOUR_NAME</th>
                        <th>ID</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.TourName</td>
                            <td>@booking.TourId</td>
                            <td>
                                <input type="hidden" name="TourId" value="@booking.TourId" />
                                <button type="submit" name="handler" value="Delete"
                                        class="btn-delete"
                                        onclick="return confirm('Delete this booking?')">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    }
</body>
</html>
