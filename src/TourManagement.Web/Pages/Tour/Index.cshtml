@page
@model TourManagement.Web.Pages.Tour.IndexModel
@{
    ViewData["Title"] = "Browse Tours";
}

<h2>Available Tours</h2>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p class="text-muted">Showing results for: <strong>@Model.SearchTerm</strong></p>
}

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name, place, or location..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="/Tour/Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found. @(string.IsNullOrEmpty(Model.SearchTerm) ? "Check back later!" : "Try a different search term.")</div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-white fs-1">🌍</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">📍 @tour.Place</p>
                        <p class="card-text">@tour.TourInfo</p>
                        <ul class="list-unstyled">
                            <li>⏱️ <strong>@tour.Days days</strong></li>
                            <li>💰 <strong>₹@tour.Price.ToString("N0")</strong></li>
                            <li>🗺️ @tour.Locations</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Tour/Details" asp-route-id="@tour.TourId" class="btn btn-outline-primary btn-sm">Details</a>
                        @if (ViewContext.HttpContext.Session.GetString("UserEmail") != null)
                        {
                            <a asp-page="/Booking/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm ms-2">Book Now</a>
                        }
                        else
                        {
                            <a asp-page="/User/Login" class="btn btn-success btn-sm ms-2">Login to Book</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
