@page "{id:int}"
@model TourManagement.Web.Pages.Tour.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h2>Delete Tour</h2>
<hr />

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
}
else
{
    <div class="alert alert-danger">
        <strong>Warning!</strong> Are you sure you want to delete this tour? This action cannot be undone.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@Model.Tour.TourName</h5>
            <dl class="row">
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>
                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">₹@Model.Tour.Price.ToString("N0")</dd>
                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>
            </dl>
        </div>
    </div>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Tour.TourId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
}
