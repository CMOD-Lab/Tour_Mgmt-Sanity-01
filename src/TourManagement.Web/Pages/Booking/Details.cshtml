@page "{id:int}"
@model TourManagement.Web.Pages.Booking.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

@if (Model.Booking == null)
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="/Booking/MyBookings" class="btn btn-secondary">Back to My Bookings</a>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4>Booking Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Booking ID</dt>
                        <dd class="col-sm-8">#@Model.Booking.BookingId</dd>

                        <dt class="col-sm-4">Tour Name</dt>
                        <dd class="col-sm-8">@Model.Booking.TourName</dd>

                        <dt class="col-sm-4">Place</dt>
                        <dd class="col-sm-8">@Model.Booking.Place</dd>

                        <dt class="col-sm-4">Booked By</dt>
                        <dd class="col-sm-8">@Model.Booking.FirstName (@Model.Booking.Email)</dd>

                        <dt class="col-sm-4">Booking Date</dt>
                        <dd class="col-sm-8">@Model.Booking.BookingDate.ToString("dd MMM yyyy HH:mm")</dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-page="/Booking/MyBookings" class="btn btn-outline-secondary">Back to My Bookings</a>
                        <a asp-page="/Booking/Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-outline-danger ms-2">Cancel Booking</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
