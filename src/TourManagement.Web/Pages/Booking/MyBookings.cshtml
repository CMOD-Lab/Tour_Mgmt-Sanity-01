@page
@model TourManagement.Web.Pages.Booking.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        You have no bookings yet. <a asp-page="/Tour/Index">Browse tours</a> to make your first booking!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Booking ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Booking Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-page="/Booking/Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-page="/Booking/Delete" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-danger ms-1">Cancel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-page="/Tour/Index" class="btn btn-primary">Browse More Tours</a>
</div>
