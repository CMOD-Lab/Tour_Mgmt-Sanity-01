@page
@model TourManagement.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2><i class="bi bi-speedometer2 me-2 text-primary"></i>Admin Dashboard</h2>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-map-fill fs-1 me-3"></i>
                    <div>
                        <h3 class="mb-0">@Model.TotalTours</h3>
                        <p class="mb-0">Total Tours</p>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-page="/Tours/Index" class="text-white text-decoration-none small">
                        Manage Tours <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-calendar-check-fill fs-1 me-3"></i>
                    <div>
                        <h3 class="mb-0">@Model.TotalBookings</h3>
                        <p class="mb-0">Total Bookings</p>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-page="/Admin/AllBookings" class="text-white text-decoration-none small">
                        View All Bookings <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-people-fill fs-1 me-3"></i>
                    <div>
                        <h3 class="mb-0">@Model.TotalUsers</h3>
                        <p class="mb-0">Registered Users</p>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-page="/Admin/Users" class="text-white text-decoration-none small">
                        Manage Users <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-lightning-fill text-warning me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Tours/Create" class="btn btn-outline-success">
                            <i class="bi bi-plus-circle me-2"></i>Add New Tour
                        </a>
                        <a asp-page="/Admin/AllBookings" class="btn btn-outline-primary">
                            <i class="bi bi-calendar-check me-2"></i>View All Bookings
                        </a>
                        <a asp-page="/Admin/Users" class="btn btn-outline-info">
                            <i class="bi bi-people me-2"></i>Manage Users
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
