@page "{email}"
@model TourManagement.Web.Pages.Admin.DeleteUserModel
@{
    ViewData["Title"] = "Delete User";
}

@if (Model.UserToDelete == null)
{
    <div class="alert alert-warning">User not found.</div>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
}
else
{
    <div class="alert alert-danger">
        <strong>Warning!</strong> Are you sure you want to delete this user? All their bookings will also be affected.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.UserToDelete.Email</dd>
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.UserToDelete.FirstName @Model.UserToDelete.LastName</dd>
                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Model.UserToDelete.City</dd>
            </dl>
        </div>
    </div>

    <form method="post">
        <input type="hidden" name="email" value="@Model.UserToDelete.Email" />
        <button type="submit" class="btn btn-danger">Delete User</button>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
}
