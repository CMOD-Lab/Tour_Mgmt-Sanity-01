@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var userEmail = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
        var userFirstName = HttpContextAccessor.HttpContext?.Session.GetString("UserFirstName");
        var isAdmin = HttpContextAccessor.HttpContext?.Session.GetString("IsAdmin");
    }
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <strong>🌍 Tour Management</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Tour/Index">Browse Tours</a>
                    </li>
                    @if (userEmail != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Booking/MyBookings">My Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/Profile">My Profile</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (userEmail != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">Welcome, @userFirstName</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/Logout">Logout</a>
                        </li>
                    }
                    else if (isAdmin == "true")
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">Admin</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/Login">User Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Login">Admin Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer mt-5 py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year Tour Management System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
