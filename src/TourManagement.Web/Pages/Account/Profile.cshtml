@page
@model TourManagement.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill text-white fs-1"></i>
                    </div>
                    <h5 class="card-title">@Model.Profile?.FullName</h5>
                    <p class="text-muted">@Model.Profile?.Email</p>
                    <span class="badge bg-success">Active User</span>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Profile Details</h5>
                </div>
                <div class="card-body">
                    @if (Model.Profile != null)
                    {
                        <dl class="row">
                            <dt class="col-sm-4">Full Name</dt>
                            <dd class="col-sm-8">@Model.Profile.FullName</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Profile.Email</dd>

                            <dt class="col-sm-4">Gender</dt>
                            <dd class="col-sm-8">@Model.Profile.Gender</dd>

                            <dt class="col-sm-4">Date of Birth</dt>
                            <dd class="col-sm-8">@Model.Profile.Dob.ToString("dd MMM yyyy")</dd>

                            <dt class="col-sm-4">Address</dt>
                            <dd class="col-sm-8">@Model.Profile.Street, @Model.Profile.City, @Model.Profile.State</dd>
                        </dl>
                    }
                </div>
                <div class="card-footer">
                    <a asp-page="/Bookings/MyBookings" class="btn btn-primary">
                        <i class="bi bi-calendar-check me-2"></i>My Bookings
                    </a>
                    <a asp-page="/Tours/Index" class="btn btn-outline-primary ms-2">
                        <i class="bi bi-search me-2"></i>Browse Tours
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
