@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron text-center py-5 bg-primary text-white rounded">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your dream vacation today!</p>
    <hr class="my-4" />
    <a class="btn btn-light btn-lg me-2" asp-page="/Tour/Index">Browse Tours</a>
    @if (ViewContext.HttpContext.Session.GetString("UserEmail") == null && ViewContext.HttpContext.Session.GetString("IsAdmin") != "true")
    {
        <a class="btn btn-outline-light btn-lg" asp-page="/User/Register">Register Now</a>
    }
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2>🗺️</h2>
                <h5 class="card-title">Explore Destinations</h5>
                <p class="card-text">Browse our wide selection of tour packages to amazing destinations.</p>
                <a asp-page="/Tour/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2>📅</h2>
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Book your tour in just a few clicks with our simple booking system.</p>
                <a asp-page="/User/Login" class="btn btn-primary">Book Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2>👤</h2>
                <h5 class="card-title">Manage Profile</h5>
                <p class="card-text">Create an account to manage your bookings and profile.</p>
                <a asp-page="/User/Register" class="btn btn-primary">Sign Up</a>
            </div>
        </div>
    </div>
</div>
