@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Add New Tour";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="/Tours/Index">Tours</a></li>
            <li class="breadcrumb-item active">Add New Tour</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Tour</h5>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.Input.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Input.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.TourName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.TourName" class="form-control" placeholder="Tour name" />
                                <span asp-validation-for="Input.TourName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Place" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Place" class="form-control" placeholder="Main destination" />
                                <span asp-validation-for="Input.Place" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Days" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Days" class="form-control" type="number" min="1" max="365" />
                                <span asp-validation-for="Input.Days" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Price" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Input.Price" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Locations" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Locations" class="form-control" placeholder="e.g., Delhi, Agra, Jaipur" />
                                <span asp-validation-for="Input.Locations" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.TourInfo" class="form-label fw-semibold"></label>
                                <textarea asp-for="Input.TourInfo" class="form-control" rows="4" placeholder="Detailed tour description..."></textarea>
                                <span asp-validation-for="Input.TourInfo" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.PicFile" class="form-label fw-semibold"></label>
                                <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
                                <span asp-validation-for="Input.PicFile" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Add Tour
                            </button>
                            <a asp-page="/Tours/Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
