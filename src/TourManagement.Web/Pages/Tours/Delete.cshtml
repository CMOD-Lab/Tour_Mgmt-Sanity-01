@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-trash me-2"></i>Delete Tour</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Are you sure you want to delete this tour? This action cannot be undone.
                    </div>

                    @if (Model.Tour != null)
                    {
                        <dl class="row">
                            <dt class="col-sm-4">Tour Name</dt>
                            <dd class="col-sm-8"><strong>@Model.Tour.TourName</strong></dd>
                            <dt class="col-sm-4">Place</dt>
                            <dd class="col-sm-8">@Model.Tour.Place</dd>
                            <dt class="col-sm-4">Days</dt>
                            <dd class="col-sm-8">@Model.Tour.Days</dd>
                            <dt class="col-sm-4">Price</dt>
                            <dd class="col-sm-8">₹@Model.Tour.Price.ToString("N0")</dd>
                        </dl>

                        <form method="post">
                            <input type="hidden" name="id" value="@Model.Tour.TourId" />
                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="bi bi-trash me-2"></i>Yes, Delete
                                </button>
                                <a asp-page="/Tours/Index" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-x-circle me-2"></i>Cancel
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
