@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="/Tours/Index">Tours</a></li>
            <li class="breadcrumb-item active">Edit Tour</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Tour</h5>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.Input.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Input.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Input.TourId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.TourName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.TourName" class="form-control" />
                                <span asp-validation-for="Input.TourName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Place" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Place" class="form-control" />
                                <span asp-validation-for="Input.Place" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Days" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Days" class="form-control" type="number" min="1" max="365" />
                                <span asp-validation-for="Input.Days" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Price" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Input.Price" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Locations" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Locations" class="form-control" />
                                <span asp-validation-for="Input.Locations" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.TourInfo" class="form-label fw-semibold"></label>
                                <textarea asp-for="Input.TourInfo" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Input.TourInfo" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                @if (!string.IsNullOrEmpty(Model.Input.ExistingPic))
                                {
                                    <div class="mb-2">
                                        <label class="form-label fw-semibold">Current Picture</label>
                                        <div>
                                            <img src="/Tour_pics/@Model.Input.ExistingPic" alt="Current tour picture" style="max-height: 150px;" class="img-thumbnail" onerror="this.style.display='none'">
                                        </div>
                                    </div>
                                }
                                <label asp-for="Input.PicFile" class="form-label fw-semibold">New Picture (optional)</label>
                                <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
                                <input type="hidden" asp-for="Input.ExistingPic" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="Input.IsActive" class="form-check-label fw-semibold">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                            <a asp-page="/Tours/Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
